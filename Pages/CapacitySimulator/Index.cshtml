@page
@model LssTraining.Web.Pages.CapacitySimulator.IndexModel
@{
    ViewData["Title"] = "Capacity Modeling Simulator";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Capacity Modeling Simulator</h1>
            <p class="text-muted">Analyze manufacturing manpower & process constraints based on synchronized data.</p>
        </div>
        <div>
            <button class="btn btn-primary shadow-sm" onclick="location.reload()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                </svg>
                Refresh Data
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4 g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-normal mb-3 text-white-50">Total Devices</h5>
                    <h2 class="fw-bold mb-0">@Model.Summary.TotalDevices</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-normal mb-3 text-white-50">Total Processes</h5>
                    <h2 class="fw-bold mb-0">@Model.Summary.TotalProcesses</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%); color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-normal mb-3 text-white-50">Active Employees</h5>
                    <h2 class="fw-bold mb-0">@Model.Summary.TotalEmployees</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Simulation Engine -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h4 class="fw-bold text-dark mb-0">Run Capacity Simulation</h4>
                    <p class="text-muted small">Input parameters to calculate required vs available hours.</p>
                </div>
                <div class="card-body px-4 pb-4">
                    <form method="post" asp-page-handler="Simulate" id="simForm">
                        @{
                            var hasAnyYearlyInput = Model.Input.HasYearlyDemand;
                        }
                        <div id="demands-container">
                            @for(int i = 0; i < Math.Max(1, Model.Input.Demands?.Count ?? 1); i++)
                            {
                                var demand = Model.Input.Demands != null && Model.Input.Demands.Count > i ? Model.Input.Demands[i] : new LssTraining.Web.Models.SimulationDemand();
                                var isDeviceMode = demand.SelectionType == "Device";
                                var isYearlyPeriod = string.Equals(demand.DemandPeriod, "Yearly", StringComparison.OrdinalIgnoreCase);
                                <div class="row g-2 align-items-end demand-row mb-3 p-3 bg-light rounded-3 border">
                                    <div class="col-md-2">
                                        <label class="form-label fw-medium small mb-1">Target Mode</label>
                                        <select name="Input.Demands[@i].SelectionType" class="form-select form-select-sm selection-type-select" onchange="onSelectionTypeChange(this)">
                                            @if (isDeviceMode)
                                            {
                                                <option value="Family">Product Family</option>
                                                <option value="Device" selected>Specific Device</option>
                                            }
                                            else
                                            {
                                                <option value="Family" selected>Product Family</option>
                                                <option value="Device">Specific Device</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3 family-group-col" style="@(isDeviceMode ? "display:none;" : "")">
                                        <label class="form-label fw-medium small mb-1">Product Family</label>
                                        <select name="Input.Demands[@i].DeviceGroupCode" class="form-select form-select-sm family-select" onchange="onFamilyChange(this)">
                                            <option value="">-- Select Product Family --</option>
                                            @if(Model.DeviceGroups != null)
                                            {
                                                foreach (var pg in Model.DeviceGroups)
                                                {
                                                    if (demand.DeviceGroupCode == pg.DeviceGroupCode)
                                                    {
                                                        <option value="@pg.DeviceGroupCode" selected>@pg.DeviceGroupCode - @pg.DeviceGroupName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@pg.DeviceGroupCode">@pg.DeviceGroupCode - @pg.DeviceGroupName</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3 device-filter-col" style="@(isDeviceMode ? "display:none;" : "")">
                                        <label class="form-label fw-medium small mb-1">Device in Family <span class="text-muted">(Optional)</span></label>
                                        <select name="Input.Demands[@i].DeviceCode" class="form-select form-select-sm family-device-select">
                                            <option value="">-- Family Master Sequence --</option>
                                            @if (Model.Devices != null)
                                            {
                                                foreach (var d in Model.Devices.Where(x => string.IsNullOrEmpty(demand.DeviceGroupCode) || x.DeviceGroupCode == demand.DeviceGroupCode))
                                                {
                                                    if (demand.DeviceCode == d.DeviceCode)
                                                    {
                                                        <option value="@d.DeviceCode" data-group="@d.DeviceGroupCode" selected>@d.DeviceCode - @d.DeviceName (@d.StepCount steps)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@d.DeviceCode" data-group="@d.DeviceGroupCode">@d.DeviceCode - @d.DeviceName (@d.StepCount steps)</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 direct-device-col" style="@(isDeviceMode ? "" : "display:none;")">
                                        <label class="form-label fw-medium small mb-1">Specific Device from Master Database</label>
                                        <select class="form-select form-select-sm direct-device-select" onchange="onDirectDeviceChange(this)">
                                            <option value="">-- Choose Specific Device --</option>
                                            @if (Model.Devices != null)
                                            {
                                                foreach (var d in Model.Devices)
                                                {
                                                    if (demand.DeviceCode == d.DeviceCode)
                                                    {
                                                        <option value="@d.DeviceCode" data-group="@d.DeviceGroupCode" selected>@d.DeviceCode - @d.DeviceName [@d.DeviceGroupCode] (@d.StepCount steps)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@d.DeviceCode" data-group="@d.DeviceGroupCode">@d.DeviceCode - @d.DeviceName [@d.DeviceGroupCode] (@d.StepCount steps)</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-medium small mb-1">Demand (Units &amp; Period)</label>
                                        <div class="input-group input-group-sm">
                                            <input name="Input.Demands[@i].DemandQuantity" type="number" class="form-control demand-qty-input" min="1" value="@(demand.DemandQuantity > 0 ? demand.DemandQuantity : 10000)" aria-label="Demand Quantity" required />
                                            <select name="Input.Demands[@i].DemandPeriod" class="form-select demand-period-select fw-semibold text-primary bg-white" style="max-width: 108px;" aria-label="Demand Period" onchange="onDemandPeriodChange()">
                                                @if (isYearlyPeriod)
                                                {
                                                    <option value="Weekly">Weekly</option>
                                                    <option value="Yearly" selected>Yearly</option>
                                                }
                                                else
                                                {
                                                    <option value="Weekly" selected>Weekly</option>
                                                    <option value="Yearly">Yearly</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        @if(i == 0) {
                                            <button type="button" class="btn btn-outline-success btn-sm w-100 fw-bold shadow-sm" onclick="addDemandRow()">+ Add</button>
                                        } else {
                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-bold shadow-sm" onclick="removeDemandRow(this)">- Del</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div id="yearly-options-panel" class="p-3 mb-2 rounded-3 border border-primary-subtle bg-primary bg-opacity-10" style="@(hasAnyYearlyInput ? "" : "display:none;")">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label asp-for="Input.WorkingWeeksPerYear" class="form-label fw-semibold small text-primary mb-1">Working Weeks / Year</label>
                                    <div class="input-group input-group-sm">
                                        <input asp-for="Input.WorkingWeeksPerYear" type="number" class="form-control bg-white" min="1" max="53" value="@(Model.Input.WorkingWeeksPerYear > 0 ? Model.Input.WorkingWeeksPerYear : 52)" />
                                        <span class="input-group-text bg-white text-muted">weeks/yr</span>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="Input.YearlyBreakdownMode" class="form-label fw-semibold small text-primary mb-1">Weekly Breakdown Strategy</label>
                                    <select asp-for="Input.YearlyBreakdownMode" class="form-select form-select-sm bg-white">
                                        <option value="CapacityFill">Max Weekly Capacity Allocation (Capacity-Driven)</option>
                                        <option value="Levelized">Evenly Distributed Across Year / Heijunka (Levelized)</option>
                                    </select>
                                </div>
                                <div class="col-md-4 small text-muted">
                                    <strong>Yearly</strong> demand is automatically broken down by week (W1–W@(Model.Input.EffectiveWeeksPerYear)) based on bottleneck machine &amp; shift capacity.
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 align-items-end mt-2 pt-3 border-top">
                            <div class="col-md-2">
                                <label asp-for="Input.ShiftSystem" class="form-label fw-medium">Work Days</label>
                                <select asp-for="Input.ShiftSystem" class="form-select" required>
                                    <option value="5-2">5-2 (5 Days)</option>
                                    <option value="6-1">6-1 (6 Days)</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Input.ShiftsPerDay" class="form-label fw-medium">Shifts / Day</label>
                                <input asp-for="Input.ShiftsPerDay" type="number" class="form-control" min="1" max="3" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-medium">
                                    Operator Hours / Shift
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">7.25h Std</span>
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control bg-light" value="7.25" readonly />
                                    <span class="input-group-text bg-light text-muted">hrs/shift</span>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Input.OvertimeLimitPercent" class="form-label fw-medium">Max OT (%)</label>
                                <div class="input-group">
                                    <input name="Input.OvertimeLimitPercent" type="number" class="form-control" step="0.1" min="0" max="100" value="@Model.Input.OvertimeLimitPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-3 text-end">
                                <button type="submit" class="btn btn-dark fw-bold shadow-sm w-100 py-2">Run Simulation</button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2 text-muted small">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-info-circle text-primary" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.896.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                            </svg>
                            <span>Standard operator working hours: <strong>7.25 hours per shift</strong> (Normal capacity: @(Model.Input.WorkingDays * Model.Input.NormalHoursPerShift) working hours per operator/week without overtime).</span>
                        </div>
                    </form>

<script>
    const allDeviceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Devices ?? Enumerable.Empty<LssTraining.Web.Models.ProductDeviceItem>()));

    function onSelectionTypeChange(selectElem) {
        const row = selectElem.closest('.demand-row');
        const isDevice = selectElem.value === 'Device';
        const familyCol = row.querySelector('.family-group-col');
        const deviceFilterCol = row.querySelector('.device-filter-col');
        const directDeviceCol = row.querySelector('.direct-device-col');
        const directDeviceSelect = row.querySelector('.direct-device-select');

        if (isDevice) {
            familyCol.style.display = 'none';
            deviceFilterCol.style.display = 'none';
            directDeviceCol.style.display = '';
            if (directDeviceSelect.value) {
                onDirectDeviceChange(directDeviceSelect);
            }
        } else {
            familyCol.style.display = '';
            deviceFilterCol.style.display = '';
            directDeviceCol.style.display = 'none';
        }
    }

    function onFamilyChange(familySelect) {
        const row = familySelect.closest('.demand-row');
        const groupCode = familySelect.value;
        const deviceSelect = row.querySelector('.family-device-select');

        deviceSelect.innerHTML = '<option value="">-- Family Master Sequence --</option>';
        if (groupCode && allDeviceData) {
            const filtered = allDeviceData.filter(d => (d.DeviceGroupCode || d.deviceGroupCode) === groupCode);
            filtered.forEach(d => {
                const code = d.DeviceCode || d.deviceCode;
                const name = d.DeviceName || d.deviceName;
                const steps = d.StepCount || d.stepCount;
                const opt = document.createElement('option');
                opt.value = code;
                opt.textContent = `${code} - ${name} (${steps} steps)`;
                deviceSelect.appendChild(opt);
            });
        }
    }

    function onDirectDeviceChange(directSelect) {
        const row = directSelect.closest('.demand-row');
        const familyDeviceSelect = row.querySelector('.family-device-select');
        const familySelect = row.querySelector('.family-select');
        const selectedCode = directSelect.value;

        if (selectedCode && allDeviceData) {
            const found = allDeviceData.find(d => (d.DeviceCode || d.deviceCode) === selectedCode);
            if (found && familySelect) {
                familySelect.value = found.DeviceGroupCode || found.deviceGroupCode;
                onFamilyChange(familySelect);
            }
        }
        if (selectedCode && !Array.from(familyDeviceSelect.options).some(o => o.value === selectedCode)) {
            const opt = document.createElement('option');
            opt.value = selectedCode;
            opt.textContent = selectedCode;
            familyDeviceSelect.appendChild(opt);
        }
        familyDeviceSelect.value = selectedCode;
    }

    function onDemandPeriodChange() {
        const periodSelects = document.querySelectorAll('.demand-period-select');
        const hasYearly = Array.from(periodSelects).some(s => s.value === 'Yearly');
        const panel = document.getElementById('yearly-options-panel');
        if (panel) {
            panel.style.display = hasYearly ? '' : 'none';
        }
    }

    let rowIdx = @(Math.Max(1, Model.Input.Demands?.Count ?? 1));
    function addDemandRow() {
        const container = document.getElementById('demands-container');
        const sourceRow = container.querySelector('.demand-row');
        const sourcePeriod = sourceRow.querySelector('.demand-period-select')?.value || 'Weekly';
        const firstRow = sourceRow.cloneNode(true);

        firstRow.querySelector('.selection-type-select').name = `Input.Demands[${rowIdx}].SelectionType`;
        firstRow.querySelector('.selection-type-select').value = 'Family';

        firstRow.querySelector('.family-select').name = `Input.Demands[${rowIdx}].DeviceGroupCode`;
        firstRow.querySelector('.family-select').value = '';

        firstRow.querySelector('.family-device-select').name = `Input.Demands[${rowIdx}].DeviceCode`;
        firstRow.querySelector('.family-device-select').value = '';

        firstRow.querySelector('.direct-device-select').value = '';
        firstRow.querySelector('.family-group-col').style.display = '';
        firstRow.querySelector('.device-filter-col').style.display = '';
        firstRow.querySelector('.direct-device-col').style.display = 'none';

        const qtyInput = firstRow.querySelector('.demand-qty-input');
        qtyInput.name = `Input.Demands[${rowIdx}].DemandQuantity`;
        qtyInput.value = sourcePeriod === 'Yearly' ? '520000' : '10000';

        const periodSelect = firstRow.querySelector('.demand-period-select');
        periodSelect.name = `Input.Demands[${rowIdx}].DemandPeriod`;
        periodSelect.value = sourcePeriod;

        const btn = firstRow.querySelector('button');
        btn.className = 'btn btn-outline-danger btn-sm w-100 fw-bold shadow-sm';
        btn.textContent = '- Del';
        btn.onclick = function() { removeDemandRow(this); };

        container.appendChild(firstRow);
        rowIdx++;
        onDemandPeriodChange();
    }

    function removeDemandRow(btn) {
        btn.closest('.demand-row').remove();
        const rows = document.querySelectorAll('.demand-row');
        rows.forEach((row, index) => {
            row.querySelector('.selection-type-select').name = `Input.Demands[${index}].SelectionType`;
            row.querySelector('.family-select').name = `Input.Demands[${index}].DeviceGroupCode`;
            row.querySelector('.family-device-select').name = `Input.Demands[${index}].DeviceCode`;
            row.querySelector('.demand-qty-input').name = `Input.Demands[${index}].DemandQuantity`;
            row.querySelector('.demand-period-select').name = `Input.Demands[${index}].DemandPeriod`;
        });
        rowIdx = rows.length;
        onDemandPeriodChange();
    }
</script>

                    @if (Model.Result != null)
                    {
                        <hr class="my-4" />
                        <div class="p-4 rounded-4 @(Model.Result.IsCapacityMet ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10")">
                            <div class="row">
                                <div class="col-md-3 border-end border-dark-subtle">
                                    <div class="text-muted small fw-bold text-uppercase">Total Bottlenecks</div>
                                    <h4 class="fw-bold @(Model.Result.Bottlenecks.Count == 0 && Model.Result.TotalYearlyShortageUnits == 0 ? "text-success" : "text-danger")">@Model.Result.Bottlenecks.Count</h4>
                                </div>
                                <div class="col-md-3 border-end border-dark-subtle">
                                    <div class="text-muted small fw-bold text-uppercase">Weekly Required Hours</div>
                                    <h4 class="fw-bold mb-0">@Model.Result.RequiredHours.ToString("N1") h/wk</h4>
                                    @if (Model.Result.HasYearlyDemand)
                                    {
                                        <small class="text-muted">Annual (@Model.Result.WorkingWeeksPerYear w): @((Model.Result.RequiredHours * Model.Result.WorkingWeeksPerYear).ToString("N0")) h</small>
                                    }
                                </div>
                                <div class="col-md-3 border-end border-dark-subtle">
                                    <div class="text-muted small fw-bold text-uppercase">Weekly Available (Inc OT)</div>
                                    <h4 class="fw-bold mb-0">@Model.Result.TotalAvailableHours.ToString("N1") h/wk</h4>
                                    @if (Model.Result.HasYearlyDemand)
                                    {
                                        <small class="text-muted">Annual (@Model.Result.WorkingWeeksPerYear w): @((Model.Result.TotalAvailableHours * Model.Result.WorkingWeeksPerYear).ToString("N0")) h</small>
                                    }
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small fw-bold text-uppercase">Weekly Shortage / Surplus</div>
                                    <h4 class="fw-bold mb-0 @(Model.Result.IsCapacityMet ? "text-success" : "text-danger")">
                                        @(Model.Result.ShortageOrSurplus > 0 ? "+" : "")@Model.Result.ShortageOrSurplus.ToString("N1") h/wk
                                    </h4>
                                    @if (Model.Result.HasYearlyDemand)
                                    {
                                        var annualDiff = Model.Result.ShortageOrSurplus * Model.Result.WorkingWeeksPerYear;
                                        <small class="text-muted">Annual: @(annualDiff > 0 ? "+" : "")@annualDiff.ToString("N0") h</small>
                                    }
                                </div>
                            </div>
                            <div class="alert @(Model.Result.IsCapacityMet ? "alert-success" : "alert-danger") mt-3 mb-4 border-0 fw-medium">
                                @Model.Result.Recommendation
                            </div>

                            @if (Model.Result.HasYearlyDemand && Model.Result.WeeklyBreakdowns != null && Model.Result.WeeklyBreakdowns.Count > 0)
                            {
                                var avgWeeklyDemand = Math.Round((decimal)Model.Result.TotalYearlyDemandUnits / Model.Result.WorkingWeeksPerYear, 0);
                                var fulfillmentPct = Model.Result.TotalYearlyDemandUnits > 0
                                    ? ((decimal)Model.Result.TotalYearlyDeliverableUnits / Model.Result.TotalYearlyDemandUnits) * 100m
                                    : 100m;
                                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">
                                                Yearly Demand &rarr; Weekly Capacity Breakdown (W1&ndash;W@(Model.Result.WorkingWeeksPerYear))
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">
                                                    @(Model.Result.YearlyBreakdownMode == "Levelized" ? "Levelized / Heijunka" : "Capacity-Driven / Weekly")
                                                </span>
                                            </h5>
                                            <small class="text-muted">
                                                Binding Constraint (TOC): <strong class="text-dark">@Model.Result.BottleneckConstraintName</strong>
                                                &bull; Normal Capacity: <strong>@Model.Result.WeeklyNormalCapacityUnits.ToString("N0") pcs/wk</strong>
                                                &bull; Max + OT (@Model.Input.OvertimeLimitPercent%): <strong>@Model.Result.WeeklyMaxCapacityUnits.ToString("N0") pcs/wk</strong>
                                            </small>
                                        </div>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Filter weeks">
                                            <button type="button" class="btn btn-outline-primary active" id="btnShowAllWeeks" onclick="filterWeeklyRows('all')">All Weeks (@Model.Result.WorkingWeeksPerYear)</button>
                                            <button type="button" class="btn btn-outline-primary" id="btnShowActiveWeeks" onclick="filterWeeklyRows('active')">Active Only (@Model.Result.ActiveProductionWeeks)</button>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="p-3 rounded-3 bg-light border h-100">
                                                <div class="text-muted small fw-semibold text-uppercase">Total Yearly Demand</div>
                                                <div class="fs-5 fw-bold text-dark">@Model.Result.TotalYearlyDemandUnits.ToString("N0") <small class="fw-normal text-muted">units</small></div>
                                                <small class="text-muted">Average: @avgWeeklyDemand.ToString("N0") units/wk</small>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="p-3 rounded-3 bg-light border h-100">
                                                <div class="text-muted small fw-semibold text-uppercase">Weekly Capacity Owned</div>
                                                <div class="fs-5 fw-bold text-primary">@Model.Result.WeeklyMaxCapacityUnits.ToString("N0") <small class="fw-normal text-muted">pcs/wk</small></div>
                                                <small class="text-muted">Normal: @Model.Result.WeeklyNormalCapacityUnits.ToString("N0") | OT: +@Model.Result.WeeklyOvertimeCapacityUnits.ToString("N0")</small>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="p-3 rounded-3 bg-light border h-100">
                                                <div class="text-muted small fw-semibold text-uppercase">Deliverable Annual Output</div>
                                                <div class="fs-5 fw-bold @(Model.Result.TotalYearlyShortageUnits == 0 ? "text-success" : "text-danger")">
                                                    @Model.Result.TotalYearlyDeliverableUnits.ToString("N0") <small class="fw-normal text-muted">units</small>
                                                </div>
                                                <small class="text-muted">Fulfillment: @fulfillmentPct.ToString("N1")% of annual target</small>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="p-3 rounded-3 bg-light border h-100">
                                                <div class="text-muted small fw-semibold text-uppercase">
                                                    @(Model.Result.TotalYearlyShortageUnits == 0 ? "Completion Horizon" : "Annual Capacity Shortage")
                                                </div>
                                                @if (Model.Result.TotalYearlyShortageUnits == 0)
                                                {
                                                    <div class="fs-5 fw-bold text-success">
                                                        Week @(Model.Result.CompletionWeek ?? Model.Result.WorkingWeeksPerYear)
                                                    </div>
                                                    <small class="text-muted">Active @Model.Result.ActiveProductionWeeks of @Model.Result.WorkingWeeksPerYear working weeks</small>
                                                }
                                                else
                                                {
                                                    <div class="fs-5 fw-bold text-danger">
                                                        -@Model.Result.TotalYearlyShortageUnits.ToString("N0") <small class="fw-normal">units</small>
                                                    </div>
                                                    <small class="text-danger">Requires ~@Model.Result.RequiredWeeksAtMaxCapacity.ToString("N1") weeks at max capacity</small>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <canvas id="weeklyBreakdownChart" height="90"></canvas>
                                    </div>

                                    <div class="table-responsive" style="max-height: 440px; overflow-y: auto;">
                                        <table class="table table-sm table-hover table-bordered align-middle mb-0" id="weeklyBreakdownTable">
                                            <thead class="table-light sticky-top shadow-sm">
                                                <tr>
                                                    <th class="text-center" style="width: 72px;">Week</th>
                                                    <th class="text-end">Target Demand</th>
                                                    <th class="text-end">Normal Allocation</th>
                                                    <th class="text-end">OT Allocation</th>
                                                    <th class="text-end">Deliverable Output</th>
                                                    <th class="text-end">Shortage</th>
                                                    <th class="text-end">Cumulative Output</th>
                                                    <th class="text-end">Remaining Yearly</th>
                                                    <th class="text-end">Bottleneck Load</th>
                                                    <th class="text-end">Headcount</th>
                                                    <th class="text-center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var wk in Model.Result.WeeklyBreakdowns)
                                                {
                                                    var isIdle = wk.TotalScheduledUnits == 0 && wk.ShortageUnits == 0;
                                                    <tr class="weekly-row @(isIdle ? "weekly-row-idle text-muted" : "")">
                                                        <td class="text-center fw-bold">W@(wk.WeekNumber.ToString("D2"))</td>
                                                        <td class="text-end">@wk.PlannedDemandUnits.ToString("N0")</td>
                                                        <td class="text-end">@wk.NormalCapacityUnits.ToString("N0")</td>
                                                        <td class="text-end @(wk.OvertimeCapacityUnits > 0 ? "text-warning-emphasis fw-semibold" : "text-muted")">
                                                            @(wk.OvertimeCapacityUnits > 0 ? "+" + wk.OvertimeCapacityUnits.ToString("N0") : "-")
                                                        </td>
                                                        <td class="text-end fw-bold @(wk.TotalScheduledUnits > 0 ? "text-primary" : "text-muted")">
                                                            @wk.TotalScheduledUnits.ToString("N0")
                                                        </td>
                                                        <td class="text-end @(wk.ShortageUnits > 0 ? "text-danger fw-bold" : "text-muted")">
                                                            @(wk.ShortageUnits > 0 ? "-" + wk.ShortageUnits.ToString("N0") : "-")
                                                        </td>
                                                        <td class="text-end">@wk.CumulativeUnits.ToString("N0")</td>
                                                        <td class="text-end">@wk.RemainingYearlyDemand.ToString("N0")</td>
                                                        <td class="text-end small">
                                                            @wk.BottleneckHoursUsed.ToString("N1") / @wk.BottleneckTotalHours.ToString("N1") h
                                                            <span class="text-muted">(@wk.UtilizationPercent.ToString("N0")%)</span>
                                                        </td>
                                                        <td class="text-end fw-medium">@wk.RequiredHeadcount</td>
                                                        <td class="text-center">
                                                            @if (wk.Status == "Shortage")
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Shortage</span>
                                                            }
                                                            else if (wk.Status == "Overtime")
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Normal + OT</span>
                                                            }
                                                            else if (wk.Status == "Completed")
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Completed</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Normal</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td class="text-center">TOTAL</td>
                                                    <td class="text-end">@Model.Result.TotalYearlyDemandUnits.ToString("N0")</td>
                                                    <td class="text-end">@Model.Result.WeeklyBreakdowns.Sum(x => x.NormalCapacityUnits).ToString("N0")</td>
                                                    <td class="text-end text-warning-emphasis">@Model.Result.WeeklyBreakdowns.Sum(x => x.OvertimeCapacityUnits).ToString("N0")</td>
                                                    <td class="text-end text-primary">@Model.Result.TotalYearlyDeliverableUnits.ToString("N0")</td>
                                                    <td class="text-end @(Model.Result.TotalYearlyShortageUnits > 0 ? "text-danger" : "text-success")">
                                                        @(Model.Result.TotalYearlyShortageUnits > 0 ? "-" + Model.Result.TotalYearlyShortageUnits.ToString("N0") : "0")
                                                    </td>
                                                    <td colspan="5" class="text-end text-muted small fw-normal">
                                                        Total Annual Capacity (@Model.Result.WorkingWeeksPerYear weeks): Normal @((Model.Result.WeeklyNormalCapacityUnits * Model.Result.WorkingWeeksPerYear).ToString("N0")) pcs | Max + OT @((Model.Result.WeeklyMaxCapacityUnits * Model.Result.WorkingWeeksPerYear).ToString("N0")) pcs
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Result.MachineResults != null && Model.Result.MachineResults.Count > 0)
                            {
                                <div>
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-fill me-2"></i>Machine Capacity Utilization (Area Chart)</h6>
                                    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
                                        <canvas id="capacityChart" height="100"></canvas>
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Result.Bottlenecks.Count > 0)
                            {
                                <div class="mt-4">
                                    <h6 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>Bottleneck Machines</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border-danger mb-0">
                                            <thead class="table-danger">
                                                <tr>
                                                    <th>Machine</th>
                                                    <th>Area</th>
                                                    <th class="text-end">Required Hrs</th>
                                                    <th class="text-end">Available Hrs</th>
                                                    <th class="text-end">Shortage</th>
                                                    <th class="text-end">Utilization</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var b in Model.Result.Bottlenecks.OrderByDescending(x => x.UtilizationPercent))
                                                {
                                                    <tr>
                                                        <td><strong>@b.MachCode</strong> - @b.MachName</td>
                                                        <td>@b.Area</td>
                                                        <td class="text-end">@b.RequiredHours.ToString("N1")</td>
                                                        <td class="text-end">@b.TotalAvailableHours.ToString("N1")</td>
                                                        <td class="text-end text-danger fw-bold">@b.ShortageOrSurplus.ToString("N1")</td>
                                                        <td class="text-end text-danger fw-bold">@b.UtilizationPercent.ToString("N0")%</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            
                            @if (Model.Result.ManpowerResults != null && Model.Result.ManpowerResults.Count > 0)
                            {
                                <div class="mt-4">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                                        <div>
                                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-people-fill me-2"></i>Required Manpower (Headcount)</h6>
                                            <small class="text-muted">Calculated based on standard <strong>7.25 working hrs/shift</strong> per operator (@(Model.Input.WorkingDays * Model.Input.NormalHoursPerShift) normal hrs/week).</small>
                                        </div>
                                        <span class="badge bg-light text-dark border px-3 py-2 shadow-sm">
                                            <i class="bi bi-person-check text-primary me-1"></i> Operator Standard: <strong>7.25 hrs/shift</strong> &bull; Total Labor: <strong>@Model.Result.TotalLaborHoursRequired.ToString("N1") hrs</strong>
                                        </span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered border-primary mb-0">
                                            <thead class="table-primary">
                                                <tr>
                                                    <th>Process Code</th>
                                                    <th>Process Name</th>
                                                    <th class="text-end">Total Labor Hrs</th>
                                                    <th class="text-end">Headcount (0% OT)</th>
                                                    <th class="text-end">Headcount (Max @Model.Input.OvertimeLimitPercent% OT)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var mp in Model.Result.ManpowerResults.OrderByDescending(x => x.TotalLaborHoursRequired))
                                                {
                                                    <tr>
                                                        <td><strong>@mp.ProcCode</strong></td>
                                                        <td>@mp.ProcName</td>
                                                        <td class="text-end">@mp.TotalLaborHoursRequired.ToString("N1") h</td>
                                                        <td class="text-end fw-bold">@mp.HeadcountZeroOvertime</td>
                                                        <td class="text-end fw-bold text-success">@mp.HeadcountWithOvertime</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td colspan="2" class="text-end">TOTAL REQUIRED:</td>
                                                    <td class="text-end">@Model.Result.TotalLaborHoursRequired.ToString("N1") h</td>
                                                    <td class="text-end text-primary fs-6">@Model.Result.TotalHeadcountZeroOvertime</td>
                                                    <td class="text-end text-success fs-6">@Model.Result.TotalHeadcountWithOvertime</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            }

                            @if (Model.Result.RoutingSteps != null && Model.Result.RoutingSteps.Count > 0)
                            {
                                <div class="mt-4">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">
                                                <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Verified Production Routing Sequence
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">@Model.Result.RoutingSteps.Count Steps in Database</span>
                                            </h6>
                                            <small class="text-muted">Production process sequence, machine allocation, and estimated cycle time (UPH) based on the latest synchronized database.</small>
                                        </div>
                                        <span class="badge bg-light text-dark border px-3 py-2 shadow-sm">
                                            Total Devices Simulated: <strong>@Model.Result.TotalDevicesSimulated</strong>
                                        </span>
                                    </div>
                                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                        <table class="table table-sm table-hover table-bordered align-middle mb-0">
                                            <thead class="table-light sticky-top shadow-sm">
                                                <tr>
                                                    <th style="width: 50px;" class="text-center">Seq</th>
                                                    <th>Device</th>
                                                    <th>Process Code</th>
                                                    <th>Process Name</th>
                                                    <th>Area</th>
                                                    <th>Assigned Machine</th>
                                                    <th class="text-end">Speed (UPH)</th>
                                                    <th class="text-end">Demand</th>
                                                    <th class="text-end">Machine Hours</th>
                                                    <th class="text-end">Labor Hours</th>
                                                    <th class="text-center">Type</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var step in Model.Result.RoutingSteps.OrderBy(x => x.DeviceCode).ThenBy(x => x.Seq))
                                                {
                                                    <tr>
                                                        <td class="text-center fw-bold text-muted">@step.Seq</td>
                                                        <td>
                                                            <strong class="text-primary">@step.DeviceCode</strong>
                                                            <div class="text-muted small">@step.DeviceName</div>
                                                        </td>
                                                        <td><span class="badge bg-secondary">@step.ProcCode</span></td>
                                                        <td class="fw-medium">@step.ProcName</td>
                                                        <td><span class="badge bg-light text-dark border">@step.Area</span></td>
                                                        <td>
                                                            @if (step.IsMachineStep)
                                                            {
                                                                <strong>@step.MachCode</strong>
                                                                <small class="text-muted d-block">@step.MachName</small>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted fst-italic">Manual Station</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">@(step.UPH > 0 ? step.UPH.ToString("N0") + " /h" : "-")</td>
                                                        <td class="text-end">
                                                            <span>@step.DemandUnits.ToString("N0") /wk</span>
                                                            @if (step.DemandPeriod == "Yearly")
                                                            {
                                                                <small class="text-muted d-block">@step.InputDemandUnits.ToString("N0") /yr</small>
                                                            }
                                                        </td>
                                                        <td class="text-end fw-bold @(step.MachineHoursRequired > 0 ? "text-dark" : "text-muted")">
                                                            @(step.MachineHoursRequired > 0 ? step.MachineHoursRequired.ToString("N1") + " h" : "-")
                                                        </td>
                                                        <td class="text-end text-primary fw-medium">@step.LaborHoursRequired.ToString("N1") h</td>
                                                        <td class="text-center">
                                                            @if (step.IsMachineStep)
                                                            {
                                                                <span class="badge bg-info-subtle text-info border border-info-subtle">Machine</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Manual</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Labor Capacity Table -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                    <h5 class="fw-bold mb-0 text-dark">Available Manpower by Section</h5>
                    <small class="text-muted">Based on BTMTime synchronization</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Section / Cost Center</th>
                                    <th class="text-end">Available Operators</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ManpowerList != null && Model.ManpowerList.Any())
                                {
                                    foreach (var item in Model.ManpowerList)
                                    {
                                        <tr>
                                            <td class="fw-medium">@item.SectionCode</td>
                                            <td class="text-end">
                                                <span class="badge bg-primary rounded-pill px-3 py-2">@item.EmployeeCount</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">No employee data synchronized. Run the DatabaseSyncApp first.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Process Breakdown -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                    <h5 class="fw-bold mb-0 text-dark">Process Distribution by Area</h5>
                    <small class="text-muted">Master production routing areas</small>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Production Area</th>
                                    <th class="text-end">Assigned Processes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ProcessAreaList != null && Model.ProcessAreaList.Any())
                                {
                                    foreach (var item in Model.ProcessAreaList)
                                    {
                                        <tr>
                                            <td class="fw-medium">@item.Area</td>
                                            <td class="text-end">
                                                <span class="badge bg-success rounded-pill px-3 py-2">@item.ProcessCount</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">No process data found. Execute CI_LSS mapping query first.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Result != null && ((Model.Result.MachineResults != null && Model.Result.MachineResults.Count > 0) || (Model.Result.WeeklyBreakdowns != null && Model.Result.WeeklyBreakdowns.Count > 0)))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            function filterWeeklyRows(mode) {
                const idleRows = document.querySelectorAll('.weekly-row-idle');
                idleRows.forEach(r => r.style.display = mode === 'active' ? 'none' : '');
                document.getElementById('btnShowAllWeeks')?.classList.toggle('active', mode !== 'active');
                document.getElementById('btnShowActiveWeeks')?.classList.toggle('active', mode === 'active');
            }

            document.addEventListener("DOMContentLoaded", function () {
                const weeklyCtx = document.getElementById('weeklyBreakdownChart');
                if (weeklyCtx) {
                    const wkData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Result.WeeklyBreakdowns ?? new List<LssTraining.Web.Models.WeeklyDemandBreakdown>()));
                    const wkLabels = wkData.map(w => 'W' + String(w.WeekNumber).padStart(2, '0'));
                    const normUnits = wkData.map(w => w.NormalCapacityUnits);
                    const otUnits = wkData.map(w => w.OvertimeCapacityUnits);
                    const shortUnits = wkData.map(w => w.ShortageUnits);
                    const normCapLine = wkData.map(() => @Model.Result.WeeklyNormalCapacityUnits);
                    const maxCapLine = wkData.map(() => @Model.Result.WeeklyMaxCapacityUnits);

                    new Chart(weeklyCtx, {
                        type: 'bar',
                        data: {
                            labels: wkLabels,
                            datasets: [
                                {
                                    type: 'line',
                                    label: 'Max Weekly Capacity (Inc. OT)',
                                    data: maxCapLine,
                                    borderColor: 'rgba(25, 135, 84, 1)',
                                    borderWidth: 2,
                                    borderDash: [6, 4],
                                    pointRadius: 0,
                                    fill: false,
                                    order: 1
                                },
                                {
                                    type: 'line',
                                    label: 'Normal Weekly Capacity (0% OT)',
                                    data: normCapLine,
                                    borderColor: 'rgba(13, 110, 253, 0.85)',
                                    borderWidth: 2,
                                    borderDash: [3, 3],
                                    pointRadius: 0,
                                    fill: false,
                                    order: 2
                                },
                                {
                                    type: 'bar',
                                    label: 'Normal Allocation (Units)',
                                    data: normUnits,
                                    backgroundColor: 'rgba(37, 99, 235, 0.82)',
                                    stack: 'weeklyLoad',
                                    order: 3
                                },
                                {
                                    type: 'bar',
                                    label: 'Overtime Allocation (Units)',
                                    data: otUnits,
                                    backgroundColor: 'rgba(245, 158, 11, 0.88)',
                                    stack: 'weeklyLoad',
                                    order: 4
                                },
                                {
                                    type: 'bar',
                                    label: 'Unmet Shortage (Units)',
                                    data: shortUnits,
                                    backgroundColor: 'rgba(220, 38, 38, 0.85)',
                                    stack: 'weeklyLoad',
                                    order: 5
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            interaction: { mode: 'index', intersect: false },
                            plugins: {
                                legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } },
                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            return context.dataset.label + ': ' + Number(context.parsed.y).toLocaleString() + ' units';
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    stacked: true,
                                    grid: { display: false },
                                    title: { display: true, text: 'Production Week', font: { weight: 'bold' } }
                                },
                                y: {
                                    stacked: true,
                                    beginAtZero: true,
                                    title: { display: true, text: 'Units / Week', font: { weight: 'bold' } }
                                }
                            }
                        }
                    });
                }

                const ctx = document.getElementById('capacityChart');
                if (ctx) {
                    const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Result.MachineResults?.OrderByDescending(x => x.RequiredHours) ?? Enumerable.Empty<LssTraining.Web.Models.MachineCapacityResult>()));
                    
                    const labels = rawData.map(d => d.MachCode);
                    const reqHours = rawData.map(d => d.RequiredHours);
                    const normalHrs = rawData.map(d => d.AvailableNormalHours);
                    const maxHrs = rawData.map(d => d.TotalAvailableHours);

                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    type: 'bar',
                                    label: 'Required Hours (Load)',
                                    data: reqHours,
                                    backgroundColor: 'rgba(220, 53, 69, 0.8)', // Bootstrap Danger Red
                                    borderColor: 'rgba(220, 53, 69, 1)',
                                    borderWidth: 1,
                                    order: 2,
                                    barPercentage: 0.6
                                },
                                {
                                    type: 'line',
                                    label: 'Max Capacity (with OT)',
                                    data: maxHrs,
                                    borderColor: 'rgba(25, 135, 84, 1)', // Bootstrap Success Green
                                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.4,
                                    order: 1
                                },
                                {
                                    type: 'line',
                                    label: 'Normal Capacity',
                                    data: normalHrs,
                                    borderColor: 'rgba(13, 110, 253, 1)', // Bootstrap Primary Blue
                                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.4,
                                    order: 3
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            plugins: {
                                tooltip: { 
                                    callbacks: {
                                        label: function(context) {
                                            return context.dataset.label + ': ' + context.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}) + ' hrs';
                                        }
                                    }
                                },
                                legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    title: { display: true, text: 'Hours', font: { weight: 'bold' } }
                                },
                                x: {
                                    title: { display: true, text: 'Machine Code', font: { weight: 'bold' } },
                                    grid: { display: false }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}

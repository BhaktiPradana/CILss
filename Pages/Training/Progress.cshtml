@page "{enrollmentId:int}"
@model LssTraining.Web.Pages.Training.ProgressModel
@{
    ViewData["Title"] = "Hours & Modules";
}

@if (Model.Enrollment is null)
{
    <div class="empty-state panel text-center py-5">
        <div class="empty-icon-circle mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
            </svg>
        </div>
        <h2>Enrollment Record Not Found</h2>
        <p class="text-muted mb-4">The requested training progress enrollment could not be found.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-page="Enrollments" class="btn btn-primary">Back to Progress List</a>
            <a asp-page="/Participants/Roadmap" class="btn btn-outline-secondary">Go to Roadmap</a>
        </div>
    </div>
}
else
{
    var completedMods = Model.Progress.Count(m => m.IsCompleted);
    var totalMods = Model.Progress.Count;
    var remainingMods = Math.Max(0, totalMods - completedMods);
    var pctMods = totalMods > 0 ? (int)Math.Round((double)completedMods / totalMods * 100) : 0;

    <div class="page-nav-bar mb-3 d-flex align-items-center gap-2">
        <a asp-page="Enrollments" class="btn btn-sm btn-light d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
            <span>Back to Progress</span>
        </a>
        <a asp-page="/Index" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5z"/>
            </svg>
            <span>Dashboard</span>
        </a>
        <a asp-page="/Participants/Roadmap" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M0 0h1v15h15v1H0V0Zm14.854 4.146a.5.5 0 0 0-.708-.708L10 7.293 7.854 5.146a.5.5 0 0 0-.708 0L3.5 8.793l.708.707L7.5 6.207l2.146 2.147a.5.5 0 0 0 .708 0l4.5-4.5Z"/>
            </svg>
            <span>Roadmap</span>
        </a>
        @if (Model.Enrollment.ProgramName.Contains("Green Belt"))
        {
            <a asp-page="/Reviews/Index" asp-route-enrollmentId="@Model.Enrollment.Id" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                <span>Review R0–R5</span>
            </a>
        }
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-end mt-4 flex-wrap gap-3">
            <div>
                <p class="eyebrow mb-2">TRAINING HOURS</p>
                <h1 class="page-title">@Model.Enrollment.ParticipantName</h1>
                <p class="page-subtitle">
                    <code>@Model.Enrollment.EmployeeId</code> · @Model.Enrollment.ProgramName
                    @if (Model.Enrollment.TocFlag)
                    {
                        <span class="toc-badge">TOC</span>
                    }
                </p>
            </div>
            <div class="text-end d-flex align-items-center gap-2">
                @if (Model.Enrollment.ProgramName.Contains("Green Belt"))
                {
                    <a asp-page="/Reviews/Index" asp-route-enrollmentId="@Model.Enrollment.Id" class="btn btn-sm btn-outline-primary">
                        View Review Gates (R0–R5) →
                    </a>
                }
                <span class="badge-status @(Model.Enrollment.Status == "Completed" ? "active" : "progressing")">
                    @Model.Enrollment.Status
                </span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-white border-start border-4 @(Model.Enrollment.Status == "Certified" ? "border-success" : completedMods == totalMods && totalMods > 0 ? "border-primary" : "border-warning")">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Training & Module Status</span>
                <h3 class="h5 mb-1 fw-bold">
                    @if (Model.Enrollment.Status == "Certified")
                    {
                        <span class="text-success">Certified · All Modules Completed (@completedMods/@totalMods Modules)</span>
                    }
                    else if (completedMods == totalMods && totalMods > 0)
                    {
                        <span class="text-primary">Completed Training · All Modules Completed (@completedMods/@totalMods Modules · 0 Modules Remaining)</span>
                    }
                    else
                    {
                        <span class="text-dark">Completed Module @completedMods of @totalMods</span>
                        <span class="badge bg-warning text-dark ms-2">@remainingMods modules remaining</span>
                    }
                </h3>
                <small class="text-muted">Total @Model.Progress.Sum(m => m.ActualHours).ToString("0.#") hrs of target @Model.Progress.Sum(m => m.TargetHours).ToString("0.#") hrs completed</small>
            </div>
            <div style="min-width: 200px; max-width: 280px; width: 100%;">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                    <span>Module Progress</span>
                    <span>@pctMods%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar @(completedMods == totalMods && totalMods > 0 ? "bg-success" : "bg-warning")" role="progressbar" style="width: @pctMods%;"></div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <section class="panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow mb-1">MODULES & HOURS</p>
                <h2>Target vs Actual</h2>
            </div>
            <span class="text-muted small">Automatic module status: Completed when actual hours ≥ target.</span>
        </div>

        <div class="module-list">
            @if (!Model.Progress.Any())
            {
                <div class="empty-state small">
                    <p>No modules found for this enrollment.</p>
                </div>
            }

            @foreach (var module in Model.Progress)
            {
                <div class="module-row">
                    <span class="module-number">✓</span>
                    <div class="flex-grow-1">
                        <strong>@module.ModuleName</strong>
                        <small>Target @module.TargetHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) hrs · Actual @module.ActualHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) hrs</small>
                        <div class="progress mt-2" style="height:6px;max-width:320px">
                            <div class="progress-bar" style="width:@Model.Percent(module)%"></div>
                        </div>
                        @if (module.IsOverridden && !string.IsNullOrWhiteSpace(module.OverrideReason))
                        {
                            <small class="d-block mt-1 text-warning">Override: @module.OverrideReason</small>
                        }
                    </div>
                    <span class="badge-status @(module.Status == "Completed" ? "active" : module.Status == "In Progress" ? "progressing" : module.Status == "Overridden" ? "progressing" : "inactive")">
                        @module.Status
                    </span>
                    @if (User.IsInRole("Admin") || User.IsInRole("Trainer"))
                    {
                        <form method="post" asp-page-handler="UpdateHours" class="d-flex gap-2 align-items-center" style="max-width:280px">
                            <input type="hidden" name="progressId" value="@module.Id" />
                            <input type="number" name="actualHours" value="@module.ActualHours" min="0" step="0.5" class="form-control form-control-sm" aria-label="Actual hours" />
                            <button class="btn btn-sm btn-primary" type="submit">Save</button>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex align-items-center text-muted small fw-semibold" style="min-width:110px; justify-content: flex-end;">
                            <span class="badge bg-light text-dark border">@module.ActualHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) / @module.TargetHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) hrs</span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

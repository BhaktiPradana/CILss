@page "{enrollmentId:int}"
@model LssTraining.Web.Pages.Reviews.IndexModel
@{
    ViewData["Title"] = "Green Belt Roadmap";
}

@if (Model.Enrollment is null)
{
    <div class="empty-state panel text-center py-5">
        <div class="empty-icon-circle mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
            </svg>
        </div>
        <h2>Enrollment Record Not Found</h2>
        <p class="text-muted mb-4">The requested Green Belt review roadmap could not be found.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-page="/Participants/Roadmap" class="btn btn-primary">Go to Participant Roadmap</a>
            <a asp-page="/Training/Enrollments" class="btn btn-outline-secondary">View All Progress</a>
        </div>
    </div>
}
else
{
    <div class="page-nav-bar mb-3 d-flex align-items-center gap-2">
        <a href="javascript:history.back()" class="btn btn-sm btn-light d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
            <span>Back</span>
        </a>
        <a asp-page="/Index" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5z"/>
            </svg>
            <span>Dashboard</span>
        </a>
        <a asp-page="/Participants/Roadmap" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M0 0h1v15h15v1H0V0Zm14.854 4.146a.5.5 0 0 0-.708-.708L10 7.293 7.854 5.146a.5.5 0 0 0-.708 0L3.5 8.793l.708.707L7.5 6.207l2.146 2.147a.5.5 0 0 0 .708 0l4.5-4.5Z"/>
            </svg>
            <span>Roadmap</span>
        </a>
        <a asp-page="/Training/Enrollments" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
            </svg>
            <span>All Progress</span>
        </a>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-end mt-4">
            <div>
                <p class="eyebrow mb-2">GREEN BELT + TOC · ROADMAP</p>
                <h1 class="page-title">@Model.Enrollment.ParticipantName</h1>
                <p class="page-subtitle">
                    <code>@Model.Enrollment.EmployeeId</code> · @Model.Enrollment.ProgramName
                    @if (Model.Enrollment.TocFlag)
                    {
                        <span class="toc-badge">TOC</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow mb-1">R0 — R5</p>
                <h2>Review Progress</h2>
            </div>
            <span class="badge-status active">@Model.Reviews.Count(x => x.Status == "Completed") / 6 completed</span>
        </div>

        <div class="review-roadmap">
            @foreach (var review in Model.Reviews)
            {
                <article class="review-card @(review.Status == "Completed" ? "done" : "")">
                    <div class="review-marker">@review.ReviewLabel</div>
                    <div class="review-content">
                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h3 class="mb-0">Gate @review.ReviewLabel · @(review.DmaicStage ?? "DMAIC") Phase</h3>
                                    <span class="badge-status @(review.Status == "Completed" ? "active" : review.Status == "In Progress" ? "progressing" : "inactive")">
                                        @review.Status
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(review.DmaicStage))
                                    {
                                        <span class="stage-badge stage-badge-@review.DmaicStage.ToLowerInvariant()">@review.DmaicStage</span>
                                    }
                                    @if (review.ReviewedAt.HasValue)
                                    {
                                        <small class="text-muted ms-2">Reviewed: @review.ReviewedAt.Value.ToString("dd MMM yyyy")</small>
                                    }
                                </div>
                            </div>
                            @if (User.IsInRole("Admin") || User.IsInRole("Trainer"))
                            {
                                <a class="btn btn-sm btn-light" asp-page="Edit" asp-route-id="@review.Id" asp-route-enrollmentId="@Model.Enrollment.Id">Edit</a>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.TrainerComment))
                        {
                            <p class="review-comment">“@review.TrainerComment”</p>
                        }
                        else
                        {
                            <p class="text-muted small mt-3 mb-0">No trainer comments yet.</p>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

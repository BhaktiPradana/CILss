@page
@model LssTraining.Web.Pages.Electricity.ImprovementsModel
@{
    ViewData["Title"] = "Machine Energy Improvements";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1 fw-bold">Machine Energy Improvements</h2>
            <p class="text-muted mb-0">Track energy reduction projects, automatic DB kWh consumption baseline, and Stacked Area Chart trends</p>
        </div>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addImprovementModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
            + Record New Improvement
        </button>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            ✓ @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="db-summary-card">
                <div class="db-summary-icon" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M6.271 5.055a.5.5 0 0 1 .52.038l3.5 2.5a.5.5 0 0 1 0 .814l-3.5 2.5A.5.5 0 0 1 6 10.5v-5a.5.5 0 0 1 .271-.445z"/>
                    </svg>
                </div>
                <div class="db-summary-content">
                    <span class="db-summary-value">@Model.Improvements.Count</span>
                    <span class="db-summary-label">Total Projects</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="db-summary-card">
                <div class="db-summary-icon" style="background: linear-gradient(135deg, #059669, #10b981);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                    </svg>
                </div>
                <div class="db-summary-content">
                    <span class="db-summary-value">@Model.Improvements.Count(x => x.Status == "Completed")</span>
                    <span class="db-summary-label">Completed</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="db-summary-card">
                <div class="db-summary-icon" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                    </svg>
                </div>
                <div class="db-summary-content">
                    <span class="db-summary-value">@Model.TotalDailySavingsKwh.ToString("N1")</span>
                    <span class="db-summary-label">kWh/day Saved</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="db-summary-card">
                <div class="db-summary-icon" style="background: linear-gradient(135deg, #6366f1, #818cf8);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1.5 1.5A.5.5 0 0 0 1 2v12a.5.5 0 0 0 .5.5h12a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5h-12zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2z"/>
                        <path d="M11.854 5.646a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8.5 8.293l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                    </svg>
                </div>
                <div class="db-summary-content">
                    <span class="db-summary-value">@Model.TotalSavingsPercentage%</span>
                    <span class="db-summary-label">Energy Reduction</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-secondary">Search Project or Machine</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="text" asp-for="SearchQuery" class="form-control border-start-0" placeholder="Search improvement title, machine..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary">Filter Machine</label>
                    <select asp-for="SelectedMachCode" asp-items="Model.MachineOptions" class="form-select shadow-sm"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary">Status</label>
                    <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="form-select shadow-sm"></select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 shadow-sm fw-bold">Apply</button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedMachCode) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-page="/Electricity/Improvements" class="btn btn-outline-secondary px-3" title="Reset">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Improvements Directory Table -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Machine Energy Improvement Projects</h5>
            <span class="text-muted small">@Model.Improvements.Count record(s) found</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Machine</th>
                        <th>Improvement Activity</th>
                        <th>Implementation Date</th>
                        <th>Auto Baseline kWh/day</th>
                        <th>Target / Actual kWh/day</th>
                        <th>Daily Savings</th>
                        <th>Status</th>
                        <th class="text-end">Actions & Chart</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Improvements.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                No energy improvement activities found. Click <strong>"+ Record New Improvement"</strong> to log an activity.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Improvements)
                    {
                        var isCompleted = item.Status == "Completed";
                        var isInProgress = item.Status == "In Progress";
                        var currentKwh = item.ActualKwhPerDay ?? item.TargetKwhPerDay;
                        var pct = item.SavingsPercentage;
                        var chartCollapseId = $"chart-collapse-{item.Id}";

                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.MachName</div>
                                <small class="badge bg-secondary bg-opacity-10 text-secondary">@item.MachCode</small>
                            </td>
                            <td style="max-width: 280px;">
                                <div class="fw-bold text-primary">@item.ImprovementTitle</div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 260px;" title="@item.Description">@item.Description</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.ImplementationDate.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">By: @(item.CreatedBy ?? "Team")</small>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@item.BaselineKwhPerDay.ToString("N1") kWh</span>
                                <small class="d-block text-muted" style="font-size: 0.72rem;">(Auto DB Log)</small>
                            </td>
                            <td>
                                <span class="fw-bold @(isCompleted ? "text-success" : "text-primary")">
                                    @currentKwh.ToString("N1") kWh
                                </span>
                                <small class="d-block text-muted" style="font-size: 0.72rem;">
                                    @(item.ActualKwhPerDay.HasValue ? "(Actual Measured)" : "(Target Calculated)")
                                </small>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">
                                        -@item.EstimatedDailySavingsKwh.ToString("N1") kWh/day (-@pct%)
                                    </span>
                                    <div class="progress" style="height: 4px; min-width: 100px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @Math.Min(100, (int)pct)%;"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (isCompleted)
                                {
                                    <span class="badge bg-success text-white px-3 py-1">✓ Completed</span>
                                }
                                else if (isInProgress)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1">⚡ In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-3 py-1">📅 Planned</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-view-chart" data-machcode="@item.MachCode" data-impldate="@item.ImplementationDate.ToString("yyyy-MM-dd")" data-title="@item.ImprovementTitle" data-bs-toggle="collapse" data-bs-target="#@chartCollapseId">
                                    📈 Stacked Chart
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this improvement record?');" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H5.5l1-1h3l1 1H14a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <!-- Expandable Stacked Area Chart Container -->
                        <tr class="p-0 border-0">
                            <td colspan="8" class="p-0 border-0">
                                <div class="collapse bg-light p-3 border-bottom" id="@chartCollapseId">
                                    <div class="card border-0 shadow-sm p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-primary">⚡ Stacked Area Chart: Before vs After Improvement</h6>
                                                <small class="text-muted">Machine: <strong>@item.MachName (@item.MachCode)</strong> · Implementation Date: <strong>@item.ImplementationDate.ToString("dd MMM yyyy")</strong></small>
                                            </div>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Auto-Synchronized DB Meter Log</span>
                                        </div>
                                        <div style="height: 280px; position: relative;">
                                            <canvas id="chart-canvas-@item.Id"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Record New Improvement -->
<div class="modal fade" id="addImprovementModal" tabindex="-1" aria-labelledby="addImprovementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addImprovementModalLabel">Record Machine Energy Improvement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Machine Selection -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Select Machine <span class="text-danger">*</span></label>
                            <select id="modalMachSelect" asp-for="NewImprovement.MachCode" class="form-select form-select-lg shadow-sm" required>
                                <option value="">-- Choose Machine --</option>
                                @foreach (var opt in Model.MachineOptions.Where(x => !string.IsNullOrEmpty(x.Value)))
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                            <div class="form-text text-primary" id="modalDbStatus">Selecting a machine will automatically fetch DB log consumption.</div>
                        </div>

                        <!-- Start Implementation Date -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Start Implementation Date <span class="text-danger">*</span></label>
                            <input id="modalImplDate" asp-for="NewImprovement.ImplementationDate" class="form-control form-control-lg shadow-sm" type="date" required />
                            <div class="form-text">Start date of energy improvement project.</div>
                        </div>

                        <!-- Improvement Title -->
                        <div class="col-12">
                            <label class="form-label fw-bold">Improvement Activity Title <span class="text-danger">*</span></label>
                            <input asp-for="NewImprovement.ImprovementTitle" class="form-control shadow-sm" placeholder="e.g. VFD Frequency Inverter Installation & Idle Regulation" required />
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label fw-bold">Description / Technical Scope</label>
                            <textarea asp-for="NewImprovement.Description" class="form-control shadow-sm" rows="2" placeholder="Technical details of the energy reduction activity..."></textarea>
                        </div>

                        <!-- Auto Calculated Baseline & Target kWh -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                Baseline kWh/day 
                                <span class="badge bg-info bg-opacity-10 text-info border border-info ms-1">Auto Calculated</span>
                            </label>
                            <input id="modalBaselineInput" asp-for="NewImprovement.BaselineKwhPerDay" class="form-control form-control-lg shadow-sm fw-bold bg-light" type="number" step="0.1" min="0" required readonly />
                            <div class="form-text">Average daily kWh BEFORE start date (from DB meter logs).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                Target kWh/day
                                <span class="badge bg-success bg-opacity-10 text-success border border-success ms-1">Auto Estimated</span>
                            </label>
                            <input id="modalTargetInput" asp-for="NewImprovement.TargetKwhPerDay" class="form-control form-control-lg shadow-sm fw-bold" type="number" step="0.1" min="0" required />
                            <div class="form-text">Target daily kWh (auto estimated or manual override).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Actual kWh/day (Optional)</label>
                            <input id="modalActualInput" asp-for="NewImprovement.ActualKwhPerDay" class="form-control form-control-lg shadow-sm fw-bold" type="number" step="0.1" min="0" placeholder="Post-improve measured kWh" />
                            <div class="form-text">Measured actual daily kWh AFTER start date.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Project Status</label>
                            <select asp-for="NewImprovement.Status" class="form-select shadow-sm">
                                <option value="In Progress">⚡ In Progress</option>
                                <option value="Completed">✓ Completed</option>
                                <option value="Planned">📅 Planned</option>
                            </select>
                        </div>

                        <!-- Live Preview Stacked Area Chart -->
                        <div class="col-12 mt-3">
                            <div class="card border-primary border-opacity-20 shadow-sm p-3 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-primary small">📊 Live Preview: Stacked Area Chart (Before vs After)</span>
                                    <span id="previewDbBadge" class="badge bg-primary bg-opacity-10 text-primary">Select machine & date above</span>
                                </div>
                                <div style="height: 220px; position: relative;">
                                    <canvas id="modalPreviewChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Save Improvement</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalMachSelect = document.getElementById('modalMachSelect');
            const modalImplDate = document.getElementById('modalImplDate');
            const modalBaselineInput = document.getElementById('modalBaselineInput');
            const modalTargetInput = document.getElementById('modalTargetInput');
            const modalActualInput = document.getElementById('modalActualInput');
            const modalDbStatus = document.getElementById('modalDbStatus');
            const previewDbBadge = document.getElementById('previewDbBadge');

            let previewChartInstance = null;

            // Trigger calculation on Machine or Date change
            modalMachSelect.addEventListener('change', fetchKwhCalculation);
            modalImplDate.addEventListener('change', fetchKwhCalculation);

            function fetchKwhCalculation() {
                const machCode = modalMachSelect.value;
                const implDate = modalImplDate.value;

                if (!machCode) {
                    modalDbStatus.textContent = 'Please select a machine to auto-calculate baseline kWh.';
                    previewDbBadge.textContent = 'Select machine above';
                    return;
                }

                modalDbStatus.textContent = 'Calculating baseline & post-improvement kWh from DB meter logs...';
                previewDbBadge.textContent = 'Loading...';

                fetch(`?handler=CalculateKwh&machCode=${encodeURIComponent(machCode)}&implDate=${encodeURIComponent(implDate)}`)
                    .then(res => res.json())
                    .then(res => {
                        if (res.success && res.data) {
                            const d = res.data;
                            modalBaselineInput.value = d.baselineKwhPerDay;
                            modalTargetInput.value = d.targetKwhPerDay;
                            if (d.actualKwhPerDay) {
                                modalActualInput.value = d.actualKwhPerDay;
                            }
                            modalDbStatus.innerHTML = `✓ Mapped DB: <strong>${d.mappedDbName}</strong> · Baseline: <strong>${d.baselineKwhPerDay} kWh/day</strong>`;
                            previewDbBadge.textContent = `Mapped DB: ${d.mappedDbName}`;

                            renderPreviewChart(d.trendPoints);
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        modalDbStatus.textContent = 'Error calculating DB baseline kWh.';
                    });
            }

            function renderPreviewChart(trendPoints) {
                const ctx = document.getElementById('modalPreviewChart').getContext('2d');
                const labels = trendPoints.map(p => p.dateLabel);
                const baselineData = trendPoints.map(p => p.baselineKwh);
                const actualData = trendPoints.map(p => p.actualKwh);

                if (previewChartInstance) {
                    previewChartInstance.destroy();
                }

                previewChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Baseline kWh (Before)',
                                data: baselineData,
                                fill: true,
                                backgroundColor: 'rgba(239, 68, 68, 0.15)',
                                borderColor: '#ef4444',
                                borderWidth: 2,
                                tension: 0.3,
                                pointRadius: 2
                            },
                            {
                                label: 'Post-Improvement kWh (After)',
                                data: actualData,
                                fill: true,
                                backgroundColor: 'rgba(16, 185, 129, 0.25)',
                                borderColor: '#10b981',
                                borderWidth: 2,
                                tension: 0.3,
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: { mode: 'index', intersect: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: { title: { display: true, text: 'kWh / day' }, beginAtZero: false }
                        }
                    }
                });
            }

            // Render Stacked Area Charts for Table Rows when Expanded
            const rowChartButtons = document.querySelectorAll('.btn-view-chart');
            const rowChartInstances = {};

            rowChartButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const machCode = this.getAttribute('data-machcode');
                    const implDate = this.getAttribute('data-impldate');
                    const targetCollapseId = this.getAttribute('data-bs-target');
                    const canvasId = targetCollapseId.replace('#chart-collapse-', 'chart-canvas-');

                    setTimeout(() => {
                        const canvas = document.getElementById(canvasId);
                        if (!canvas) return;

                        if (rowChartInstances[canvasId]) {
                            return; // Already initialized
                        }

                        fetch(`?handler=CalculateKwh&machCode=${encodeURIComponent(machCode)}&implDate=${encodeURIComponent(implDate)}`)
                            .then(res => res.json())
                            .then(res => {
                                if (res.success && res.data) {
                                    const d = res.data;
                                    const labels = d.trendPoints.map(p => p.dateLabel);
                                    const baselineData = d.trendPoints.map(p => p.baselineKwh);
                                    const actualData = d.trendPoints.map(p => p.actualKwh);

                                    const ctx = canvas.getContext('2d');
                                    rowChartInstances[canvasId] = new Chart(ctx, {
                                        type: 'line',
                                        data: {
                                            labels: labels,
                                            datasets: [
                                                {
                                                    label: 'Baseline kWh (Before Improvement)',
                                                    data: baselineData,
                                                    fill: true,
                                                    backgroundColor: 'rgba(239, 68, 68, 0.15)',
                                                    borderColor: '#ef4444',
                                                    borderWidth: 2,
                                                    tension: 0.3,

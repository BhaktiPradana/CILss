@page
@model LssTraining.Web.Pages.Electricity.IndexModel
@{
    ViewData["Title"] = "Electricity Consumption Dashboard";
}

<div class="container-fluid mt-3 mb-5 px-3 px-lg-4">
    <!-- HERO HEADER -->
    <div class="electricity-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-25 text-white border border-primary border-opacity-50 px-3 py-1 rounded-pill">
                        ⚡ Power & Energy Management
                    </span>
                    @if (Model.HasDatabaseError)
                    {
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                            ⚠️ Live Simulation / Preview Mode
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-25 text-white border border-success border-opacity-50 px-3 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                            <span class="active-glow-dot" style="width:7px;height:7px;"></span> Database Connected
                        </span>
                    }
                    @if (Model.AnomalySummary.TotalAnomaliesDetected > 0)
                    {
                        <button type="button" class="badge bg-danger text-white px-3 py-1 rounded-pill text-decoration-none fw-bold shadow-sm border-0 d-inline-flex align-items-center gap-1" onclick="openVoltHelpModal();">
                            <span>⚡</span> @Model.AnomalySummary.TotalAnomaliesDetected Volt-Help Alerts
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-25 text-white border border-success border-opacity-50 px-3 py-1 rounded-pill d-inline-flex align-items-center gap-1">
                            <span>⚡</span> Volt-Help: Nominal
                        </span>
                    }
                </div>
                <h1 class="h2 fw-bold text-white mb-1">Electricity Consumption Dashboard</h1>
                <p class="text-white-50 mb-0">Continuous monitoring of electrical distribution boards (DB), switchboards (SSB), and equipment panels</p>
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <!-- VOLT-HELP NOTIFICATION DROPDOWN -->
                <div class="dropdown d-inline-block">
                    <button class="btn btn-outline-light btn-sm shadow-sm position-relative d-inline-flex align-items-center gap-2 dropdown-toggle" type="button" id="voltHelpDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-warning" viewBox="0 0 16 16">
                            <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                        </svg>
                        <span class="fw-bold">Volt-Help</span>
                        @if (Model.AnomalySummary.TotalAnomaliesDetected > 0)
                        {
                            <span class="badge rounded-pill bg-danger border border-light">
                                @Model.AnomalySummary.TotalAnomaliesDetected
                            </span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg p-0" aria-labelledby="voltHelpDropdown" style="min-width: 360px; max-width: 420px; border-radius: 12px; overflow: hidden; z-index: 1060;">
                        <li class="p-3 bg-dark text-white d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5 text-warning">⚡</span>
                                <div>
                                    <div class="fw-bold fs-6">Volt-Help Notifications</div>
                                    <div class="small text-white-50">Energy Abnormality Alert System</div>
                                </div>
                            </div>
                            <span class="badge @(Model.AnomalySummary.TotalAnomaliesDetected > 0 ? "bg-danger" : "bg-success") px-2 py-1">
                                @Model.AnomalySummary.TotalAnomaliesDetected Alert@(Model.AnomalySummary.TotalAnomaliesDetected > 1 ? "s" : "")
                            </span>
                        </li>
                        <div style="max-height: 320px; overflow-y: auto;">
                        @if (Model.AnomalySummary.TopAnomalies.Any())
                        {
                            @foreach (var anom in Model.AnomalySummary.TopAnomalies)
                            {
                                var badgeBg = anom.Severity == "CRITICAL" ? "bg-danger text-white" : "bg-warning text-dark";
                                var safeExpl = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(anom.Explanation);
                                var safeReco = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(anom.Recommendation);
                                <li>
                                    <a class="dropdown-item p-3 border-bottom text-wrap" href="javascript:void(0)" onclick="openVoltHelpInspection('@anom.MeterName', '@anom.DisplayName', '@anom.Building', '@anom.Floor', '@anom.AnomalyType', '@anom.Severity', '@anom.ActualKwh.ToString("N1")', '@anom.ExpectedKwh.ToString("N1")', '@anom.DeviationKwh.ToString("N1")', '@anom.DeviationPercent.ToString("N0")', '@anom.ConfidencePercent.ToString("F1")', '@anom.Timestamp.ToString("yyyy-MM-dd HH:mm")', '@safeExpl', '@safeReco');">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                            <strong class="text-dark text-truncate" style="max-width: 220px;">@anom.DisplayName</strong>
                                            <span class="badge @badgeBg" style="font-size: 0.65rem;">@anom.Severity</span>
                                        </div>
                                        <div class="small text-muted mb-1 d-flex justify-content-between">
                                            <span>@(anom.Building) · @anom.Floor</span>
                                            <span class="text-danger fw-bold">+@anom.DeviationKwh.ToString("N1") kWh</span>
                                        </div>
                                        <div class="small text-secondary" style="font-size: 0.78rem;">
                                            @(anom.AnomalyType == "OffHoursLeakage" ? "🌙 Off-Hours Leakage" : "⚡ Spike Surge"): @anom.Explanation
                                        </div>
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="p-4 text-center text-muted">
                                <div class="fs-4 mb-1">✅</div>
                                <div class="fw-bold">All Distribution Boards Nominal</div>
                                <div class="small">No consumption abnormalities detected.</div>
                            </li>
                        }
                        </div>
                        <li class="p-2 bg-light border-top d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm w-100 fw-semibold" onclick="openVoltHelpModal();">
                                ⚡ Open Volt-Help View
                            </button>
                            @if (Model.AnomalySummary.TotalAnomaliesDetected > 0)
                            {
                                <a asp-page="/Electricity/Index" 
                                   asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
                                   asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
                                   asp-route-Building="@Model.Building"
                                   asp-route-Floor="@Model.Floor"
                                   asp-route-ViewMode="@Model.ViewMode"
                                   asp-route-OnlyAbnormal="@(!Model.OnlyAbnormal)"
                                   class="btn @(Model.OnlyAbnormal ? "btn-danger" : "btn-outline-danger") btn-sm text-nowrap fw-semibold">
                                    @(Model.OnlyAbnormal ? "All Cards" : "Filter Abnormal")
                                </a>
                            }
                        </li>
                    </ul>
                </div>

                <a asp-page="/Electricity/DbMapping" class="btn btn-outline-light btn-sm shadow-sm d-inline-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022z"/>
                    </svg>
                    DB Mapping Directory
                </a>
                <a asp-page="/Electricity/Improvements" class="btn btn-primary btn-sm shadow-sm d-inline-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.896.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    Energy Improvements
                </a>
            </div>
        </div>
    </div>

    <!-- QUICK BUILDING SELECTOR TABS -->
    <div class="d-flex align-items-center gap-2 mb-4 overflow-auto pb-1">
        <span class="text-muted fw-bold small text-uppercase me-2">Quick Filter:</span>
        <a asp-page="/Electricity/Index" 
           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           asp-route-ViewMode="@Model.ViewMode" 
           class="btn @(string.IsNullOrEmpty(Model.Building) ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill px-3 shadow-sm">
            All Buildings (130 Cards)
        </a>
        <a asp-page="/Electricity/Index" 
           asp-route-Building="Building 207" 
           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           asp-route-ViewMode="@Model.ViewMode" 
           class="btn @(Model.Building == "Building 207" ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill px-3 shadow-sm">
            🏢 Building 207 (69 Cards)
        </a>
        <a asp-page="/Electricity/Index" 
           asp-route-Building="Building 209" 
           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           asp-route-ViewMode="@Model.ViewMode" 
           class="btn @(Model.Building == "Building 209" ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill px-3 shadow-sm">
            🏭 Building 209 (60 Cards)
        </a>
        <a asp-page="/Electricity/Index" 
           asp-route-Building="Building 238" 
           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           asp-route-ViewMode="@Model.ViewMode" 
           class="btn @(Model.Building == "Building 238" ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill px-3 shadow-sm">
            ⚡ Building 238 (1 Card)
        </a>
        @if (Model.AnomalySummary.TotalAnomaliesDetected > 0)
        {
            <a asp-page="/Electricity/Index" 
               asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
               asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
               asp-route-Building="@Model.Building"
               asp-route-Floor="@Model.Floor"
               asp-route-ViewMode="@Model.ViewMode" 
               asp-route-OnlyAbnormal="@(!Model.OnlyAbnormal)" 
               class="btn @(Model.OnlyAbnormal ? "btn-danger" : "btn-outline-danger") btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                <span>⚡</span> Volt-Help Abnormalities (@Model.AnomalySummary.TotalAnomaliesDetected)
            </a>
        }
    </div>

    <!-- SUMMARY KPI METRICS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="electricity-kpi-card">
                <div class="electricity-kpi-icon" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                    </svg>
                </div>
                <div>
                    <div class="electricity-kpi-lbl">Total Period Energy</div>
                    <div class="electricity-kpi-val">@Model.Summary.TotalKwh.ToString("N1") <span class="fs-6 text-muted fw-normal">kWh</span></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="electricity-kpi-card">
                <div class="electricity-kpi-icon" style="background: linear-gradient(135deg, #059669, #10b981);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2.5 0A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0h-11zm1 3h9a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm0 4h9a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm0 4h9a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                    </svg>
                </div>
                <div>
                    <div class="electricity-kpi-lbl">Monitored Cards</div>
                    <div class="electricity-kpi-val">@Model.Summary.ActiveCards <span class="fs-6 text-muted fw-normal">/ @Model.Summary.TotalCards</span></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="electricity-kpi-card">
                <div class="electricity-kpi-icon" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                    </svg>
                </div>
                <div>
                    <div class="electricity-kpi-lbl">Daily Average</div>
                    <div class="electricity-kpi-val">@Model.Summary.AverageDailyKwh.ToString("N1") <span class="fs-6 text-muted fw-normal">kWh/d</span></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="electricity-kpi-card">
                <div class="electricity-kpi-icon" style="background: linear-gradient(135deg, #7c3aed, #8b5cf6);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm11.5 5.5a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 0 0 1h2a.5.5 0 0 0 .5-.5zm-4 0a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 0 0 1h2a.5.5 0 0 0 .5-.5zm-4 0a.5.5 0 0 0-.5-.5H1.5a.5.5 0 0 0 0 1H3a.5.5 0 0 0 .5-.5z"/>
                    </svg>
                </div>
                <div>
                    <div class="electricity-kpi-lbl">Top Consumer</div>
                    <div class="electricity-kpi-val text-truncate" style="max-width: 170px;" title="@Model.Summary.PeakMeterName">@Model.Summary.PeakMeterName</div>
                    <small class="text-muted fw-semibold">@Model.Summary.PeakUsage.ToString("N1") kWh</small>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN FILTER CONTROLS -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-3 p-md-4 bg-light rounded">
            <form method="get" id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3 col-lg-2">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Building</label>
                    <select asp-for="Building" asp-items="Model.BuildingOptions" class="form-select shadow-sm" onchange="document.getElementById('filterForm').submit();"></select>
                </div>

                <div class="col-md-3 col-lg-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Floor / Section</label>
                    <select asp-for="Floor" asp-items="Model.FloorOptions" class="form-select shadow-sm" onchange="document.getElementById('filterForm').submit();"></select>
                </div>

                <div class="col-md-3 col-lg-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Search Card / Meter</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="text" asp-for="SearchTerm" class="form-control border-start-0" placeholder="e.g. Reflow, SSB1T, AC..." />
                    </div>
                </div>

                <div class="col-md-3 col-lg-2">
                    <label class="form-label fw-bold text-secondary small text-uppercase">View Mode</label>
                    <select asp-for="ViewMode" class="form-select shadow-sm">
                        <option value="Daily">Daily Summary</option>
                        <option value="Hourly">Hourly Detail</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-2">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Start Date</label>
                    <input type="date" asp-for="StartDate" class="form-control shadow-sm" />
                </div>

                <div class="col-md-6 col-lg-2">
                    <label class="form-label fw-bold text-secondary small text-uppercase">End Date</label>
                    <input type="date" asp-for="EndDate" class="form-control shadow-sm" />
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Distribution Board</label>
                    <select asp-for="SelectedMeter" asp-items="Model.MeterOptions" class="form-select shadow-sm"></select>
                </div>

                <div class="col-md-6 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 shadow-sm fw-bold">
                        Apply Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Building) || !string.IsNullOrEmpty(Model.Floor) || !string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SelectedMeter))
                    {
                        <a asp-page="/Electricity/Index" class="btn btn-outline-secondary px-3" title="Clear All Filters">✕</a>
                    }
                </div>
            </form>

            <!-- Quick Date Presets -->
            <div class="d-flex align-items-center gap-2 mt-3 pt-3 border-top border-secondary border-opacity-10 flex-wrap">
                <span class="text-muted small fw-semibold">Date Range Presets:</span>
                <a href="#" class="preset-pill" onclick="setDateRange(0); return false;">Today</a>
                <a href="#" class="preset-pill" onclick="setDateRange(7); return false;">Last 7 Days</a>
                <a href="#" class="preset-pill" onclick="setDateRange(30); return false;">Last 30 Days</a>
                <a href="#" class="preset-pill" onclick="setDateRange(90); return false;">Last 90 Days</a>
            </div>
        </div>
    </div>

    @if (Model.OnlyAbnormal)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex justify-content-between align-items-center mb-4 p-3 rounded-3">
            <div class="d-flex align-items-center gap-3">
                <span class="fs-3 text-warning">⚡</span>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Volt-Help Focused View Active</h6>
                    <div class="small text-muted">Displaying only distribution boards with detected abnormalities (@Model.Cards.Count cards).</div>
                </div>
            </div>
            <a asp-page="/Electricity/Index" 
               asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
               asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
               asp-route-Building="@Model.Building"
               asp-route-Floor="@Model.Floor"
               asp-route-ViewMode="@Model.ViewMode"
               class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                Reset to All Cards
            </a>
        </div>
    }

    <!-- CARDS DISPLAY SECTION -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h3 class="h4 fw-bold text-dark mb-0">Electrical Distribution Board Cards</h3>
                <p class="text-muted small mb-0">Displaying @Model.Cards.Count meter card(s) matching your filter</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                    <span class="active-glow-dot me-1"></span> @Model.Summary.ActiveCards Active
                </span>
                <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                    <span class="standby-dot me-1"></span> @(Model.Cards.Count - Model.Summary.ActiveCards) Standby / Zero
                </span>
            </div>
        </div>

        @if (!Model.Cards.Any())
        {
            <div class="alert alert-info border-0 shadow-sm text-center py-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16" class="text-primary mb-3">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.896.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                </svg>
                <h5>No Distribution Board Cards Found</h5>
                <p class="text-muted">No cards match your filter criteria. Try selecting "All Buildings" or clearing your search term.</p>
                <a asp-page="/Electricity/Index" class="btn btn-outline-primary btn-sm rounded-pill px-4">Reset Filters</a>
            </div>
        }
        else
        {
            @foreach (var floorGroup in Model.CardsByFloor)
            {
                var floorName = floorGroup.Key;
                var floorCards = floorGroup.Value;
                var floorTotal = floorCards.Where(c => c.Unit == "kWh").Sum(c => c.TotalUsage);

                <div class="floor-section-header">
                    <div class="d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="text-primary">
                            <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022z"/>
                        </svg>
                        <h4 class="floor-section-title">@floorName</h4>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">
                            @floorCards.Count Cards
                        </span>
                    </div>
                    <div class="small fw-bold text-muted">
                        Subtotal: <span class="text-primary">@floorTotal.ToString("N1") kWh</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    @foreach (var card in floorCards)
                    {
                        var isActive = card.HasData && card.TotalUsage > 0;
                        var anomalyBorder = card.HasAnomaly 
                            ? (card.AnomalySeverity == "CRITICAL" ? "border-danger border-2 shadow" : "border-warning border-2 shadow-sm") 
                            : "";
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="electricity-card @(isActive ? "is-active" : "is-standby") @(card.IsAccumulated ? "border-primary border-2 shadow-sm" : "") @anomalyBorder h-100" id="card-@card.CardTitle.Replace(" ", "").Replace("#", "").Replace(".", "_")">
                                <div class="electricity-card-header">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        @if (isActive)
                                        {
                                            <span class="active-glow-dot" title="Active meter transmitting load data"></span>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold" style="font-size:0.7rem;">ONLINE</span>
                                        }
                                        else
                                        {
                                            <span class="standby-dot" title="Standby / No records for period"></span>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold" style="font-size:0.7rem;">STANDBY</span>
                                        }
                                        @if (card.IsAccumulated)
                                        {
                                            <span class="badge bg-primary text-white fw-bold" style="font-size:0.68rem;">ACCUMULATED</span>
                                        }
                                        @if (card.HasAnomaly)
                                        {
                                            var badgeClass = card.AnomalySeverity == "CRITICAL" ? "bg-danger text-white" : "bg-warning text-dark";
                                            <span class="badge @badgeClass fw-bold" style="font-size:0.68rem; cursor:pointer;" title="Volt-Help: Abnormal consumption detected (Click for diagnostics)" onclick="openVoltHelpModal();">
                                                ⚡ Volt-Help @card.AnomalySeverity
                                            </span>
                                        }
                                    </div>
                                    <span class="badge bg-light text-muted border" style="font-size:0.72rem;">@card.PanelType</span>
                                </div>

                                <div class="electricity-card-body">
                                    <div class="electricity-title" title="@card.CardTitle">
                                        @card.CardTitle
                                    </div>
                                    @if (!string.IsNullOrEmpty(card.Subtitle))
                                    {
                                        <div class="electricity-sub">@card.Subtitle</div>
                                    }
                                    
                                    <div class="electricity-tag" title="@card.MeterName">
                                        @card.MeterName
                                    </div>

                                    @if (card.IsAccumulated && card.ConstituentDisplayNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 my-2">
                                            @foreach (var cName in card.ConstituentDisplayNames)
                                            {
                                                <span class="badge bg-light text-primary border" style="font-size:0.65rem;">@cName</span>
                                            }
                                        </div>
                                    }

                                    <div class="electricity-usage-row">
                                        <div>
                                            <span class="electricity-usage-num">@card.TotalUsage.ToString("N1")</span>
                                            <span class="electricity-usage-unit">@card.Unit</span>
                                        </div>
                                        <div class="text-end">
                                            @if (card.Unit == "kWh")
                                            {
                                                <div class="electricity-daily-avg">Avg: <strong>@card.AverageDaily.ToString("N1")</strong>/d</div>
                                                <div class="text-muted" style="font-size:0.7rem;">Peak: @card.PeakUsage.ToString("N1")</div>
                                            }
                                            else
                                            {
                                                <div class="electricity-daily-avg">Phase: <strong>A-B</strong></div>
                                                <div class="text-muted" style="font-size:0.7rem;">Status: Nominal</div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="electricity-card-footer">
                                    <span class="small text-muted" style="font-size:0.72rem;">
                                        @(card.Building) · @card.Floor
                                    </span>
                                    <button type="button" 
                                            class="btn btn-outline-primary btn-sm py-0 px-2 fw-semibold" 
                                            style="font-size:0.75rem;" 
                                            onclick="focusMeterTrend('@card.MeterName', '@card.CardTitle');">
                                        Trend →
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- CONSUMPTION TIMELINE CHART -->
    <div class="card shadow-sm border-0 mb-4" id="trendChartSection">
        <div class="card-header bg-white pt-3 pb-2 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold text-primary mb-0">
                    📈 Electricity Consumption Trend
                </h5>
                <p class="text-muted small mb-0">Timeline load profile across selected distribution boards</p>
            </div>
            <div id="chartBadgeContainer">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                    Mode: @Model.ViewMode Summary
                </span>
            </div>
        </div>
        <div class="card-body">
            <div id="consumptionApexChart" style="min-height: 380px;"></div>
        </div>
    </div>

    <!-- DETAILED CONSUMPTION DATA TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white pt-3 pb-2 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold text-dark mb-0">📋 Consumption Log Records</h5>
                <p class="text-muted small mb-0">Direct readings from database table for filtered distribution boards</p>
            </div>
            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1 rounded-pill">
                @Model.Records.Count records
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th class="ps-4">@(Model.ViewMode == "Hourly" ? "Date & Time" : "Date")</th>
                            <th>Building & Floor</th>
                            <th>Distribution Board (Meter Name)</th>
                            <th class="text-end pe-4">Consumption</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records != null && Model.Records.Any())
                        {
                            var displayRecs = Model.Records.Take(300).ToList();
                            @foreach (var item in displayRecs)
                            {
                                var resolved = LssTraining.Web.Data.ElectricityCatalog.ResolveMeter(item.MeterName);
                                <tr>
                                    <td class="ps-4 text-nowrap">
                                        @(Model.ViewMode == "Hourly" ? item.Timestamp.ToString("dd MMM yyyy HH:mm") : item.Timestamp.ToString("dd MMM yyyy"))
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">@resolved.Building</span>
                                        <span class="badge bg-light text-dark border">@resolved.Floor</span>
                                    </td>
                                    <td>
                                        <strong>@resolved.CardTitle</strong>
                                        <div class="small text-muted font-monospace" style="font-size:0.75rem;">@item.MeterName</div>
                                    </td>
                                    <td class="text-end fw-bold text-primary pe-4">
                                        @item.Usage_kWh.ToString("N2") <span class="small text-muted">@resolved.Unit</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No records available for the selected parameters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- VOLT-HELP ABNORMALITY DIAGNOSTIC CENTER MODAL -->
<div class="modal fade" id="voltHelpModal" tabindex="-1" aria-labelledby="voltHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #31104b 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #f59e0b, #ef4444); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4); flex-shrink: 0;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" class="text-white">
                            <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="modal-title fw-bold text-white mb-0" id="voltHelpModalLabel">Volt-Help Diagnostic Center</h4>
                            <span class="badge bg-danger text-white px-2 py-1" style="font-size: 0.72rem;">Abnormality Focus</span>
                        </div>
                        <p class="text-white-50 small mb-0 mt-1">
                            Focused intelligent analysis on electrical consumption spikes, off-hours phantom loads, and Lean Six Sigma recommendations.
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-light">
                <!-- Mini KPI Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 p-3 bg-white rounded-3">
                            <div class="text-muted small text-uppercase fw-semibold">Total Abnormalities</div>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <span class="fs-3 fw-bold @(Model.AnomalySummary.TotalAnomaliesDetected > 0 ? "text-danger" : "text-success")">
                                    @Model.AnomalySummary.TotalAnomaliesDetected
                                </span>
                                <span class="small text-muted">events</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 p-3 bg-white rounded-3">
                            <div class="text-muted small text-uppercase fw-semibold">Critical Spikes</div>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <span class="fs-3 fw-bold @(Model.AnomalySummary.CriticalAnomaliesCount > 0 ? "text-danger" : "text-muted")">
                                    @Model.AnomalySummary.CriticalAnomaliesCount
                                </span>
                                <span class="small text-muted">&gt;150% baseline</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 p-3 bg-white rounded-3">
                            <div class="text-muted small text-uppercase fw-semibold">Off-Hours Phantom Load</div>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <span class="fs-3 fw-bold @(Model.AnomalySummary.OffHoursLeakagesCount > 0 ? "text-primary" : "text-muted")">
                                    @Model.AnomalySummary.OffHoursLeakagesCount
                                </span>
                                <span class="small text-muted">weekend/night leak</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 p-3 bg-white rounded-3">
                            <div class="text-muted small text-uppercase fw-semibold">Est. Energy Waste</div>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <span class="fs-3 fw-bold text-warning">
                                    @Model.AnomalySummary.TotalEstimatedWastedKwh.ToString("N1")
                                </span>
                                <span class="small text-muted">kWh</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.AnomalySummary.TopAnomalies.Any())
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-uppercase fw-bold text-secondary small mb-0" style="letter-spacing: 0.5px;">
                            Detected Incidents Requiring Attention (@Model.AnomalySummary.TopAnomalies.Count)
                        </h6>
                    </div>

                    <div class="row g-3">
                        @foreach (var anom in Model.AnomalySummary.TopAnomalies)
                        {
                            var cardBorder = anom.Severity == "CRITICAL" ? "border-danger border-2" : "border-warning border-2";
                            var badgeBg = anom.Severity == "CRITICAL" ? "bg-danger text-white" : "bg-warning text-dark";
                            <div class="col-12 col-lg-6">
                                <div class="card h-100 shadow-sm @cardBorder bg-white rounded-3">
                                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-2 px-3 border-0">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @badgeBg fw-bold">@anom.Severity</span>
                                            @if (anom.AnomalyType == "OffHoursLeakage")
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">🌙 Off-Hours Leakage</span>
                                            }
                                            else if (anom.AnomalyType == "SpikeSurge")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">⚡ Spike Surge</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">📊 Baseline Shift</span>
                                            }
                                        </div>
                                        <span class="small text-muted font-monospace" style="font-size: 0.75rem;">
                                            @anom.Timestamp.ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    </div>
                                    <div class="card-body p-3 pt-1">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">@anom.DisplayName</h6>
                                                <div class="small text-muted font-monospace" style="font-size: 0.72rem;">@anom.MeterName</div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-light text-secondary border">@anom.Building</span>
                                                <span class="badge bg-light text-secondary border">@anom.Floor</span>
                                            </div>
                                        </div>

                                        <div class="p-2 mb-2 rounded bg-light border d-flex justify-content-around text-center" style="font-size: 0.8rem;">
                                            <div>
                                                <div class="text-muted small">Actual</div>
                                                <div class="fw-bold text-dark">@anom.ActualKwh.ToString("N1") kWh</div>
                                            </div>
                                            <div class="border-end"></div>
                                            <div>
                                                <div class="text-muted small">Baseline</div>
                                                <div class="fw-bold text-secondary">@anom.ExpectedKwh.ToString("N1") kWh</div>
                                            </div>
                                            <div class="border-end"></div>
                                            <div>
                                                <div class="text-muted small">Deviation</div>
                                                <div class="fw-bold text-danger">+@anom.DeviationKwh.ToString("N1") kWh (+@anom.DeviationPercent.ToString("N0")%)</div>
                                            </div>
                                            <div class="border-end"></div>
                                            <div>
                                                <div class="text-muted small">Confidence</div>
                                                <div class="fw-bold text-primary">@anom.ConfidencePercent.ToString("F1")%</div>
                                            </div>
                                        </div>

                                        <div class="small text-muted mb-2">
                                            <strong>Root Cause Analysis:</strong> @anom.Explanation
                                        </div>

                                        <div class="p-2 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25 small text-dark">
                                            <strong>💡 Actionable Recommendation:</strong> @anom.Recommendation
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 d-flex justify-content-end p-3 pt-0">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary fw-semibold" 
                                                onclick="focusMeterTrendAndCloseModal('@anom.MeterName', '@anom.DisplayName');">
                                            Focus Trend in Graph →
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-success border-0 shadow-sm p-4 text-center rounded-3">
                        <div class="fs-1 text-success mb-2">✅</div>
                        <h5 class="fw-bold text-success">All Distribution Boards Nominal</h5>
                        <p class="text-muted mb-0">No power spikes, abnormal baseline shifts, or off-hours phantom loads detected for the selected period.</p>
                    </div>
                }
            </div>

            <div class="modal-footer bg-white d-flex justify-content-between p-3 border-top">
                <div>
                    @if (Model.AnomalySummary.TotalAnomaliesDetected > 0)
                    {
                        <a asp-page="/Electricity/Index" 
                           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
                           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
                           asp-route-Building="@Model.Building"
                           asp-route-Floor="@Model.Floor"
                           asp-route-ViewMode="@Model.ViewMode"
                           asp-route-OnlyAbnormal="@(!Model.OnlyAbnormal)"
                           class="btn @(Model.OnlyAbnormal ? "btn-danger" : "btn-outline-danger") btn-sm rounded-pill px-3 fw-semibold">
                            @(Model.OnlyAbnormal ? "Show All Distribution Boards" : "Filter Dashboard to Abnormal Cards Only")
                        </a>
                    }
                </div>
                <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- VOLT-HELP SINGLE INCIDENT INSPECTION MODAL -->
<div class="modal fade" id="voltHelpInspectionModal" tabindex="-1" aria-labelledby="voltHelpInspectionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5 text-warning">⚡</span>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="vhiTitle">Panel Name</h5>
                        <div class="small text-white-50 font-monospace" id="vhiMeter">Meter ID</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge" id="vhiSeverityBadge">CRITICAL</span>
                        <span class="badge bg-secondary bg-opacity-10 text-dark border" id="vhiTypeBadge">Spike Surge</span>
                    </div>
                    <div class="small text-muted font-monospace" id="vhiTimestamp">2026-11-08 12:00</div>
                </div>

                <div class="small text-muted mb-3" id="vhiLocation">Building 207 · Floor 1</div>

                <div class="p-3 mb-3 rounded bg-light border">
                    <div class="row g-2 text-center" style="font-size: 0.85rem;">
                        <div class="col-6">
                            <div class="text-muted small">Actual Consumption</div>
                            <div class="fw-bold fs-6 text-dark" id="vhiActual">0.0 kWh</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Expected Baseline</div>
                            <div class="fw-bold fs-6 text-secondary" id="vhiExpected">0.0 kWh</div>
                        </div>
                        <div class="col-6 mt-2 pt-2 border-top">
                            <div class="text-muted small">Deviation</div>
                            <div class="fw-bold text-danger" id="vhiDeviation">+0.0 kWh (+0%)</div>
                        </div>
                        <div class="col-6 mt-2 pt-2 border-top">
                            <div class="text-muted small">Confidence</div>
                            <div class="fw-bold text-primary" id="vhiConfidence">95.0%</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="fw-bold text-dark small text-uppercase mb-1">Diagnostic Root Cause</label>
                    <p class="text-muted small mb-0" id="vhiExplanation">Explanation text</p>
                </div>

                <div class="p-3 rounded bg-warning bg-opacity-10 border border-warning border-opacity-25">
                    <label class="fw-bold text-dark small text-uppercase mb-1">💡 Actionable Recommendation</label>
                    <div class="small text-dark fw-semibold" id="vhiRecommendation">Recommendation text</div>
                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-top d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="openVoltHelpModal();">
                    View All Abnormalities
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm rounded-pill fw-semibold" id="vhiTrendBtn">
                        Focus Trend in Graph →
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        var apexChartInstance = null;

        function openVoltHelpModal() {
            var modalElem = document.getElementById('voltHelpModal');
            if (modalElem) {
                var modal = bootstrap.Modal.getOrCreateInstance(modalElem);
                modal.show();
            }
        }

        function openVoltHelpInspection(meterName, displayName, building, floor, anomalyType, severity, actual, expected, dev, devPct, conf, timestamp, explanation, recommendation) {
            document.getElementById('vhiTitle').innerText = displayName;
            document.getElementById('vhiMeter').innerText = meterName;
            document.getElementById('vhiLocation').innerText = building + ' · ' + floor;
            document.getElementById('vhiTimestamp').innerText = timestamp;
            document.getElementById('vhiActual').innerText = actual + ' kWh';
            document.getElementById('vhiExpected').innerText = expected + ' kWh';
            document.getElementById('vhiDeviation').innerText = '+' + dev + ' kWh (+' + devPct + '%)';
            document.getElementById('vhiConfidence').innerText = conf + '%';
            document.getElementById('vhiExplanation').innerText = explanation;
            document.getElementById('vhiRecommendation').innerText = recommendation;

            var sevBadge = document.getElementById('vhiSeverityBadge');
            if (severity === 'CRITICAL') {
                sevBadge.className = 'badge bg-danger text-white';
                sevBadge.innerText = 'CRITICAL';
            } else {
                sevBadge.className = 'badge bg-warning text-dark';
                sevBadge.innerText = 'WARNING';
            }

            var typeBadge = document.getElementById('vhiTypeBadge');
            if (anomalyType === 'OffHoursLeakage') {
                typeBadge.innerText = '🌙 Off-Hours Leakage';
                typeBadge.className = 'badge bg-info bg-opacity-25 text-info border border-info border-opacity-50';
            } else if (anomalyType === 'SpikeSurge') {
                typeBadge.innerText = '⚡ Spike Surge';
                typeBadge.className = 'badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50';
            } else {
                typeBadge.innerText = '📊 Baseline Shift';
                typeBadge.className = 'badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50';
            }

            var trendBtn = document.getElementById('vhiTrendBtn');
            trendBtn.onclick = function() {
                var inspectModal = bootstrap.Modal.getInstance(document.getElementById('voltHelpInspectionModal'));
                if (inspectModal) inspectModal.hide();
                focusMeterTrend(meterName, displayName);
            };

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('voltHelpInspectionModal'));
            modal.show();
        }

        function focusMeterTrendAndCloseModal(meterName, cardTitle) {
            var voltModal = bootstrap.Modal.getInstance(document.getElementById('voltHelpModal'));
            if (voltModal) voltModal.hide();
            var inspectModal = bootstrap.Modal.getInstance(document.getElementById('voltHelpInspectionModal'));
            if (inspectModal) inspectModal.hide();
            focusMeterTrend(meterName, cardTitle);
        }

        function setDateRange(daysAgo) {
            var today = new Date();
            var endStr = today.toISOString().split('T')[0];
            var start = new Date();
            if (daysAgo > 0) {
                start.setDate(today.getDate() - daysAgo);
            }
            var startStr = start.toISOString().split('T')[0];

            document.getElementById('StartDate').value = startStr;
            document.getElementById('EndDate').value = endStr;
            document.getElementById('filterForm').submit();
        }

        function focusMeterTrend(meterName, cardTitle) {
            // Scroll to chart
            var chartElem = document.getElementById('trendChartSection');
            if (chartElem) {
                chartElem.scrollIntoView({ behavior: 'smooth' });
            }

            // Set SelectedMeter in dropdown and submit to load full time series
            var meterSelect = document.getElementById('SelectedMeter');
            if (meterSelect) {
                var found = false;
                for (var i = 0; i < meterSelect.options.length; i++) {
                    if (meterSelect.options[i].value === meterName) {
                        meterSelect.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                if (found) {
                    document.getElementById('filterForm').submit();
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            var chartPayload = @Html.Raw(Model.ChartDataJson);

            if (!chartPayload || !chartPayload.categories || chartPayload.categories.length === 0) {
                document.getElementById('consumptionApexChart').innerHTML = 
                    '<div class="text-center text-muted py-5">No trend data available for current selection</div>';
                return;
            }

            var options = {
                series: chartPayload.series,
                chart: {
                    type: 'area',
                    height: 380,
                    stacked: false,
                    toolbar: {
                        show: true,
                        tools: {
                            download: true,
                            selection: true,
                            zoom: true,
                            zoomin: true,
                            zoomout: true,
                            pan: true,
                            reset: true
                        }
                    },
                    fontFamily: 'Plus Jakarta Sans, sans-serif'
                },
                colors: ['#2563eb', '#059669', '#d97706', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#4b5563'],
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: 'smooth',
                    width: 2
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.55,
                        opacityTo: 0.05,
                        stops: [0, 90, 100]
                    }
                },
                legend: {
                    position: 'top',
                    horizontalAlign: 'left',
                    fontSize: '12px',
                    fontWeight: 600,
                    markers: {
                        radius: 12
                    }
                },
                xaxis: {
                    categories: chartPayload.categories,
                    type: 'category',
                    labels: {
                        style: {
                            colors: '#64748b',
                            fontSize: '11px',
                            fontWeight: 500
                        },
                        rotate: -30,
                        rotateAlways: false
                    }
                },
                yaxis: {
                    labels: {
                        formatter: function(val) {
                            var unit = chartPayload.unit || 'kWh';
                            return val.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' ' + unit;
                        },
                        style: {
                            colors: '#64748b',
                            fontSize: '11px'
                        }
                    }
                },
                tooltip: {
                    theme: 'light',
                    y: {
                        formatter: function(val) {
                            var unit = chartPayload.unit || 'kWh';
                            return val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + unit;
                        }
                    }
                },
                grid: {
                    borderColor: '#f1f5f9',
                    strokeDashArray: 4
                }
            };

            apexChartInstance = new ApexCharts(document.querySelector("#consumptionApexChart"), options);
            apexChartInstance.render();
        });
    </script>
}
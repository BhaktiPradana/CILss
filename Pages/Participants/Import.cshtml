@page
@model LssTraining.Web.Pages.Participants.ImportModel
@{
    ViewData["Title"] = "Import Participants";
}

<div class="page-nav-bar mb-3 d-flex align-items-center gap-2">
    <a asp-page="Index" class="btn btn-sm btn-light d-inline-flex align-items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        <span>Back to Participants</span>
    </a>
    <a asp-page="/Index" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5z"/>
        </svg>
        <span>Dashboard</span>
    </a>
</div>

<div class="mb-4">
    <p class="eyebrow mb-2">BULK IMPORT</p>
    <h1 class="page-title">Import Participants from CSV</h1>
    <p class="page-subtitle">Upload CSV file with columns: <code>EmployeeId, FullName, Email, Department, Position, StatusPhase</code></p>
</div>

<section class="panel form-panel">
    @if (Model.Result is null)
    {
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label" for="File">CSV File *</label>
                <input class="form-control" type="file" name="File" accept=".csv,text/csv" required />
            </div>
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="SkipDuplicates" id="SkipDuplicates" checked />
                <label class="form-check-label" for="SkipDuplicates">Skip rows with existing Employee ID</label>
            </div>
            <div class="form-actions">
                <a class="btn btn-light" asp-page="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Process Import</button>
            </div>
        </form>
    }
    else
    {
        <div class="import-summary">
            <div class="summary-tile ok">
                <strong>@Model.Result.Created</strong>
                <span>Successfully imported</span>
            </div>
            <div class="summary-tile warn">
                <strong>@Model.Result.Skipped</strong>
                <span>Skipped (duplicate)</span>
            </div>
            <div class="summary-tile bad">
                <strong>@Model.Result.Errors.Count</strong>
                <span>Failed rows</span>
            </div>
        </div>

        @if (Model.Result.Errors.Count > 0)
        {
            <h2 class="h6 mt-4">Failure Details</h2>
            <ul class="error-list">
                @foreach (var error in Model.Result.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="form-actions">
            <a class="btn btn-primary" asp-page="Index">Done</a>
            <a class="btn btn-light" asp-page="Import">Import More</a>
        </div>
    }
</section>

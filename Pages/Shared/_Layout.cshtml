<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CILeanSixSigma</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="top-nav">
            <div class="nav-shell">
                <a class="brand" asp-page="/Index">
                    <span class="brand-dot"></span>
                    <span>CI<span class="brand-muted">LeanSixSigma</span></span>
                </a>

                <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                </button>

                <div class="collapse nav-collapse" id="mainNav">
                    <ul class="nav-menu">
                        <li><a asp-page="/Index">Dashboard</a></li>
                        <li><a asp-page="/Participants/Index">Participants</a></li>
                        <li><a asp-page="/Participants/Roadmap">Roadmap</a></li>
                        <li><a asp-page="/Training/Index">Training</a></li>
                        <li><a asp-page="/Training/Enrollments">Progress</a></li>
                        <li><a asp-page="/Electricity/Index">Electricity</a></li>
                    </ul>

                    <div class="nav-user">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="avatar small">@User.Identity.Name?.Split(' ').Select(x => x[0]).FirstOrDefault()</span>
                            <span class="nav-user-info">
                                <strong>@User.Identity.Name</strong>
                                <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                            </span>

                            <form asp-page="/Account/Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm login-nav-button d-inline-flex align-items-center gap-2" asp-page="/Account/Login">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                                </svg>
                                <span>Login</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>